<% content_for :title, "Sign In" %>

<div class="max-w-md mx-auto w-full">
  <div class="mb-8 text-center">
    <h1 class="app-page-title">Sign In</h1>
  </div>

  <div class="app-panel">
    <div class="app-panel-body">
      <%= form_with url: login_path, method: :post, scope: :session, local: true, class: "app-form", data: { turbo: false } do |form| %>
        <% if flash[:alert].present? %>
          <div role="alert" class="alert alert-error mb-6">
            <span><%= flash[:alert] %></span>
          </div>
        <% end %>

        <div class="app-field">
          <%= form.label :email, class: "app-field-label" %>
          <%= form.email_field :email, class: "input w-full focus:input-primary", autofocus: true, autocomplete: "username" %>
        </div>

        <div class="app-field">
          <%= form.label :password, class: "app-field-label" %>
          <%= form.password_field :password, class: "input w-full focus:input-primary", autocomplete: "current-password" %>
        </div>

        <div class="pt-4">
          <%= form.submit "Sign In", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
