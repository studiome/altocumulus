<% content_for :title, t(".title") %>

<div class="max-w-4xl mx-auto w-full">

  <div class="mb-8 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <%= link_to patient_path(@patient), class: "btn btn-circle btn-ghost" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      <% end %>
      <div>
        <h1 class="font-bold text-4xl"><%= t(".heading") %></h1>
        <p class="text-base-content/60"><%= @patient.name %> / <span class="font-mono"><%= @patient.hospital_id %></span></p>
      </div>
    </div>
    <%= link_to t(".add_diagnosis_button"), new_patient_patient_diagnosis_path(@patient), class: "btn btn-primary" %>
  </div>

  <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th class="bg-base-200"><%= PatientDiagnosis.human_attribute_name(:diagnosis_id) %></th>
            <th class="bg-base-200"><%= t("patient_diagnoses.labels.diagnosed_on") %></th>
            <th class="bg-base-200 text-right"><%= t("common.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% if @patient_diagnoses.any? %>
            <% @patient_diagnoses.each do |patient_diagnosis| %>
              <tr class="row-hover">
                <td class="font-semibold"><%= patient_diagnosis.display_name %></td>
                <td><%= l(patient_diagnosis.diagnosed_on, format: :default) %></td>
                <td class="text-right flex justify-end gap-2">
                  <%= link_to t("common.view"), patient_patient_diagnosis_path(@patient, patient_diagnosis), class: "btn btn-ghost btn-xs text-primary" %>
                  <%= link_to t("common.edit"), edit_patient_patient_diagnosis_path(@patient, patient_diagnosis), class: "btn btn-ghost btn-xs text-secondary" %>
                  <%= button_to t("common.delete"), patient_patient_diagnosis_path(@patient, patient_diagnosis), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: t("common.confirm_delete") } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="3" class="text-center py-10 text-base-content/50 italic">
                <%= t(".empty") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>