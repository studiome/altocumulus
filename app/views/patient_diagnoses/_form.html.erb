<%= form_with(model: [patient, patient_diagnosis], class: "space-y-6") do |form| %>
  <% if patient_diagnosis.errors.any? %>
    <div role="alert" class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <h3 class="font-bold"><%= pluralize(patient_diagnosis.errors.count, "error") %> prohibited this diagnosis entry from being saved:</h3>
        <ul class="list-disc ml-6">
          <% patient_diagnosis.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-control w-full">
      <label class="label">
        <span class="label-text font-semibold text-base">Patient Name</span>
      </label>
      <input type="text" value="<%= patient.name %>" class="input input-bordered w-full" disabled>
    </div>

    <div class="form-control w-full">
      <label class="label">
        <span class="label-text font-semibold text-base">Patient ID</span>
      </label>
      <input type="text" value="<%= patient.hospital_id %>" class="input input-bordered w-full font-mono" disabled>
    </div>
  </div>

  <% if defined?(@diagnoses) && @diagnoses.none? %>
    <div role="alert" class="alert alert-warning" id="patient_diagnosis_no_diagnoses_warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div class="flex items-center justify-between w-full gap-4">
        <span>No diagnosis masters found. Create a diagnosis first before registering this entry.</span>
        <%= link_to "New Diagnosis", new_diagnosis_path, class: "btn btn-sm btn-outline", data: { turbo_frame: "diagnosis_modal_frame" } %>
      </div>
    </div>
  <% end %>

  <div class="form-control w-full">
    <div class="flex items-center justify-between gap-3">
      <%= form.label :diagnosis_id, class: "label" do %>
        <span class="label-text font-semibold text-base">Diagnosis Name</span>
      <% end %>
      <%= link_to "New Diagnosis", new_diagnosis_path, class: "btn btn-link no-underline px-0", data: { turbo_frame: "diagnosis_modal_frame" } %>
    </div>
    <%= form.collection_select :diagnosis_id, @diagnoses, :id, :name, { prompt: "Select a diagnosis" }, class: "select select-bordered w-full focus:select-primary" %>
  </div>

  <div class="form-control w-full">
    <%= form.label :diagnosed_on, class: "label" do %>
      <span class="label-text font-semibold text-base">Diagnosed On</span>
    <% end %>
    <%= form.date_field :diagnosed_on, class: "input input-bordered w-full focus:input-primary" %>
  </div>

  <div class="pt-4" id="patient_diagnosis_submit">
    <%= form.submit "Save Diagnosis Entry", class: "btn btn-primary w-full", disabled: defined?(@diagnoses) && @diagnoses.none? %>
  </div>
<% end %>