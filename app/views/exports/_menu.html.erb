<%# The "CSV出力" dropdown: one link per configured export that fits `view`.
    `params_hash` carries the screen's range / filters so the file covers what
    the screen shows (see ExportSource). Renders nothing for non-exporters. %>
<% definitions = exports_for_view(view) %>
<% if definitions.any? %>
  <details class="dropdown dropdown-end print:hidden" id="export-menu-<%= view %>">
    <summary class="btn btn-ghost btn-sm"><%= t("exports.menu_label") %></summary>
    <ul class="menu dropdown-content z-20 mt-1 w-56 rounded-box bg-base-100 p-2 shadow">
      <% definitions.each do |definition| %>
        <li><%= link_to definition.title, export_path(definition.key, params_hash.merge(view: view)), data: { turbo: false } %></li>
      <% end %>
    </ul>
  </details>
<% end %>
