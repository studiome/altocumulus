<% content_for :title, t(".title") %>

<div class="max-w-2xl mx-auto w-full">

  <div class="mb-8 flex items-center gap-4">
    <%= link_to elective_slot_rules_path, class: "btn btn-circle btn-ghost" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    <% end %>
    <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
  </div>

  <div class="card bg-base-100 shadow-xl border border-base-200">
    <div class="card-body">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h2 class="card-title text-3xl mb-1 text-primary"><%= @elective_slot_rule.day_name %></h2>
          <p class="text-base-content/60 font-mono"><%= t(".subtitle") %></p>
        </div>
        <div class="badge badge-outline badge-lg p-4"><%= t(".badge") %></div>
      </div>

      <div class="divider"><%= t("common.information") %></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
        <div>
          <span class="text-xs font-bold uppercase text-base-content/40 block mb-1"><%= t("elective_slot_rules.labels.slot_count") %></span>
          <span class="text-lg font-medium"><%= @elective_slot_rule.slot_count_display %></span>
          <% if @elective_slot_rule.total_slots.to_s != @elective_slot_rule.slot_count_display %>
            <p class="app-helper"><%= t(".fractional_helper", total: @elective_slot_rule.total_slots) %></p>
          <% end %>
        </div>
        <div>
          <span class="text-xs font-bold uppercase text-base-content/40 block mb-1"><%= t(".slot_duration_label") %></span>
          <span class="text-lg font-medium"><%= @elective_slot_rule.slot_duration_minutes %> <%= t("elective_slot_rules.units.minutes") %> (<%= @elective_slot_rule.slot_duration_hours %> <%= t("elective_slot_rules.units.hours") %>)</span>
        </div>
        <div>
          <span class="text-xs font-bold uppercase text-base-content/40 block mb-1"><%= t(".total_capacity_label") %></span>
          <span class="text-lg font-medium"><%= @elective_slot_rule.total_minutes_display %> <%= t("elective_slot_rules.units.minutes") %></span>
        </div>
      </div>

      <div class="card-actions justify-end mt-4 pt-6 border-t border-base-200">
        <%= link_to t(".edit_button"), edit_elective_slot_rule_path(@elective_slot_rule), class: "btn btn-secondary" %>
        <%= button_to t(".delete_button"), @elective_slot_rule, method: :delete, class: "btn btn-outline btn-error", data: { turbo_confirm: t("common.confirm_delete") } %>
      </div>
    </div>
  </div>
</div>
