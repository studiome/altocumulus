<% content_for :title, t(".title") %>

<div class="w-full">

  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="font-bold text-4xl mb-2"><%= t(".title") %></h1>
      <p class="text-base-content/60"><%= t(".description") %></p>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th class="bg-base-200"><%= t(".day_header") %></th>
            <th class="bg-base-200"><%= t(".slots_header") %></th>
            <th class="bg-base-200"><%= t(".slot_duration_header") %></th>
            <th class="bg-base-200 text-right"><%= t("common.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% ElectiveSlotRule.day_names.each_with_index do |day_name, day_of_week| %>
            <% rule = @elective_slot_rules[day_of_week] %>
            <tr class="row-hover">
              <td class="font-semibold"><%= day_name %></td>
              <% if rule %>
                <td><%= rule.slot_count_display %></td>
                <td><%= rule.slot_duration_minutes %> <%= t("elective_slot_rules.units.minutes") %></td>
                <td class="text-right flex justify-end gap-2">
                  <%= link_to t("common.view"), rule, class: "btn btn-ghost btn-xs text-primary" %>
                  <%= link_to t("common.edit"), edit_elective_slot_rule_path(rule), class: "btn btn-ghost btn-xs text-secondary" %>
                  <%= button_to t("common.delete"), rule, method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: t("common.confirm_delete") } %>
                </td>
              <% else %>
                <td colspan="2" class="text-base-content/50 italic"><%= t(".not_configured") %></td>
                <td class="text-right">
                  <%= link_to t(".add_link"), new_elective_slot_rule_path(day_of_week: day_of_week), class: "btn btn-ghost btn-xs text-primary" %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
