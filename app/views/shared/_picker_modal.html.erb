<%# locals: dialog_id, frame_id, title, description %>
<dialog id="<%= dialog_id %>" class="modal modal-middle" data-controller="picker-modal">
  <div class="modal-box p-0 max-w-2xl">
    <%= turbo_frame_tag frame_id, data: { action: "turbo:frame-load->picker-modal#open" } do %>
      <div class="p-6">
        <div class="flex items-start justify-between gap-4 mb-6">
          <div>
            <h2 class="text-2xl font-bold"><%= title %></h2>
            <p class="text-sm text-base-content/60"><%= description %></p>
          </div>
          <button type="button" class="btn btn-ghost btn-sm" data-action="picker-modal#close"><%= t("common.close") %></button>
        </div>
        <div class="text-sm text-base-content/60"><%= t(".loading") %></div>
      </div>
    <% end %>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button aria-label="<%= t("common.close") %>"></button>
  </form>
</dialog>
