<% if pagination.total_pages > 1 %>
  <div class="flex justify-center pt-2">
    <div class="join">
      <% if pagination.previous_page %>
        <%= link_to "Prev", url_for(request.query_parameters.merge(page: pagination.previous_page)), class: "join-item btn btn-sm" %>
      <% else %>
        <span class="join-item btn btn-sm btn-disabled">Prev</span>
      <% end %>

      <span class="join-item btn btn-sm btn-disabled">Page <%= pagination.page %> of <%= pagination.total_pages %></span>

      <% if pagination.next_page %>
        <%= link_to "Next", url_for(request.query_parameters.merge(page: pagination.next_page)), class: "join-item btn btn-sm" %>
      <% else %>
        <span class="join-item btn btn-sm btn-disabled">Next</span>
      <% end %>
    </div>
  </div>
<% end %>
