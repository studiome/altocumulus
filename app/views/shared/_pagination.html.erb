<% if pagination.total_pages > 1 %>
  <div class="flex justify-center pt-2">
    <div class="join">
      <% if pagination.previous_page %>
        <%= link_to t(".prev"), url_for(request.query_parameters.merge(page: pagination.previous_page)), class: "join-item btn btn-sm" %>
      <% else %>
        <span class="join-item btn btn-sm btn-disabled"><%= t(".prev") %></span>
      <% end %>

      <span class="join-item btn btn-sm btn-disabled"><%= t(".page_of", page: pagination.page, total: pagination.total_pages) %></span>

      <% if pagination.next_page %>
        <%= link_to t(".next"), url_for(request.query_parameters.merge(page: pagination.next_page)), class: "join-item btn btn-sm" %>
      <% else %>
        <span class="join-item btn btn-sm btn-disabled"><%= t(".next") %></span>
      <% end %>
    </div>
  </div>
<% end %>
