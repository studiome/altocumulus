<dialog id="diagnosis_modal" class="modal modal-middle" data-controller="diagnosis-modal">
  <div class="modal-box p-0 max-w-2xl">
    <turbo-frame id="diagnosis_modal_frame" data-action="turbo:frame-load->diagnosis-modal#open">
      <div class="p-6">
        <div class="flex items-start justify-between gap-4 mb-6">
          <div>
            <h2 class="text-2xl font-bold"><%= t("diagnoses.new.title") %></h2>
            <p class="text-sm text-base-content/60"><%= t("diagnoses.new.modal_description") %></p>
          </div>
          <button type="button" class="btn btn-ghost btn-sm" data-action="diagnosis-modal#close"><%= t("common.close") %></button>
        </div>
        <div class="text-sm text-base-content/60"><%= t(".loading") %></div>
      </div>
    </turbo-frame>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button aria-label="<%= t("common.close") %>"></button>
  </form>
</dialog>