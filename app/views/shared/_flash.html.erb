<%# One toast stack, so a notice and an alert shown together do not overlap. %>
<% if notice.present? || alert.present? %>
  <div class="toast toast-top toast-end z-50 print:hidden" data-controller="flash-toast">
    <% if notice.present? %>
      <div class="alert alert-success">
        <span><%= notice %></span>
        <%# The path is one our own controller put in the flash; still, only ever render a local path. %>
        <% notice_link = flash[:notice_link] %>
        <% if notice_link.is_a?(Hash) && notice_link["path"].to_s.match?(%r{\A/(?!/)}) %>
          <%= link_to notice_link["label"], notice_link["path"], class: "link font-semibold" %>
        <% end %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="alert alert-error">
        <span><%= alert %></span>
      </div>
    <% end %>
  </div>
<% end %>
