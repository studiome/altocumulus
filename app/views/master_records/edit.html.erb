<% content_for :title, t(".title", record: master_class.model_name.human) %>

<div class="max-w-xl mx-auto w-full">
  <div class="mb-3 flex items-center gap-3">
    <%= link_to collection_path, class: "btn btn-circle btn-ghost" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    <% end %>
    <h1 class="app-page-title"><%= t(".title", record: master_class.model_name.human) %></h1>
  </div>

  <div class="app-panel">
    <div class="card-body">
      <%= render "master_records/form", record: @record %>
    </div>
  </div>
</div>
