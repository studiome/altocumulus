<dialog id="surgery_procedure_modal" class="modal modal-middle" data-controller="surgery-procedure-modal">
  <div class="modal-box p-0 max-w-2xl">
    <turbo-frame id="surgery_procedure_modal_frame" data-action="turbo:frame-load->surgery-procedure-modal#open">
      <div class="p-6">
        <div class="flex items-start justify-between gap-4 mb-6">
          <div>
            <h2 class="text-2xl font-bold">New Surgery Procedure</h2>
            <p class="text-sm text-base-content/60">Create a procedure master without leaving this surgery form.</p>
          </div>
          <button type="button" class="btn btn-ghost btn-sm" data-action="surgery-procedure-modal#close">Close</button>
        </div>
        <div class="text-sm text-base-content/60">Loading...</div>
      </div>
    </turbo-frame>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button aria-label="Close"></button>
  </form>
</dialog>