<%# locals: patient_selected, patient_id, patient_diagnoses, selected_patient_diagnosis_ids

    Rendered both as part of the surgery form and as the standalone
    turbo-frame response from SurgeriesController#patient_fields, so it must
    not receive a FormBuilder -- only plain *_tag helpers, whose field names
    still land inside the surrounding <form> regardless of which response
    rendered them.

    t("surgeries.form.…") uses the full key rather than the relative t(".…")
    form, since this partial is also rendered under surgeries/patient_fields,
    which would otherwise resolve lazy lookups against the wrong scope. %>
<%= turbo_frame_tag "surgery_patient_scoped_fields", data: { surgery_patient_fields_target: "frame" } do %>
  <div class="space-y-3" data-controller="surgery-diagnosis-fields"
       data-action="patient_diagnosis:picked@window->surgery-diagnosis-fields#add">
    <div>
      <span class="app-field-label"><%= t("surgeries.labels.related_diagnoses") %></span>
      <p class="app-helper"><%= t("surgeries.form.related_diagnoses_helper") %></p>
    </div>

    <%= hidden_field_tag "surgery[patient_diagnosis_ids][]", "" %>

    <% selected_entries = patient_diagnoses.select { |entry| selected_patient_diagnosis_ids.include?(entry.id) } %>

    <div class="space-y-2" data-surgery-diagnosis-fields-target="list">
      <% selected_entries.each do |entry| %>
        <%= render "surgery_diagnosis_row", entry: entry %>
      <% end %>
    </div>

    <template data-surgery-diagnosis-fields-target="template">
      <%= render "surgery_diagnosis_row", entry: nil %>
    </template>

    <div class="app-empty-state" data-surgery-diagnosis-fields-target="empty" <%= "hidden" if selected_entries.any? %>>
      <% if patient_selected %>
        <%= t("surgeries.form.no_diagnoses_selected") %>
      <% else %>
        <%= t("surgeries.form.select_patient_first") %>
      <% end %>
    </div>

    <div class="flex items-center justify-between gap-3">
      <span class="app-helper"><%= t("surgeries.form.diagnoses_helper") %></span>
      <% if patient_selected %>
        <%= link_to t("surgeries.form.choose_diagnosis_button"), diagnosis_picker_surgeries_path(patient_id: patient_id),
            class: "btn btn-outline btn-sm", data: { turbo_frame: "surgery_diagnosis_picker_frame" } %>
      <% end %>
    </div>
  </div>
<% end %>
