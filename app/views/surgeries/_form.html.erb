<%= form_with(model: surgery, class: "app-form", data: { controller: "surgery-diagnosis-link-filter" }) do |form| %>
  <% if surgery.errors.any? %>
    <div role="alert" class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <h3 class="font-bold"><%= pluralize(surgery.errors.count, "error") %> prohibited this surgery from being saved:</h3>
        <ul class="list-disc ml-6">
          <% surgery.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% if patients.none? %>
    <div role="alert" class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div class="flex items-center justify-between w-full gap-4">
        <span>No patients found. Create a patient first to register a surgery.</span>
        <%= link_to "New Patient", new_patient_path, class: "btn btn-sm btn-outline" %>
      </div>
    </div>
  <% end %>

  <% if surgery_procedures.none? %>
    <div role="alert" class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div class="flex items-center justify-between w-full gap-4">
        <span>No procedure names found. Create a procedure master first, or open the new procedure screen.</span>
        <%= link_to "New Procedure", new_surgery_procedure_path, class: "btn btn-sm btn-outline", data: { turbo_frame: "surgery_procedure_modal_frame" } %>
      </div>
    </div>
  <% end %>

  <div class="app-field">
    <%= form.label :patient_id, "Patient", class: "app-field-label" %>
    <%= form.collection_select :patient_id, patients, :id, :to_s, { prompt: "Select a patient" }, class: "select select-bordered w-full focus:select-primary", data: { surgery_diagnosis_link_filter_target: "patientSelect", action: "change->surgery-diagnosis-link-filter#filter" } %>
  </div>

  <div class="space-y-3">
    <div>
      <%= form.label :patient_diagnosis_ids, "Related Diagnoses", class: "app-field-label" %>
      <p class="app-helper">Select one or more diagnoses that correspond to this surgery.</p>
    </div>

    <% if patient_diagnoses.any? %>
      <div class="space-y-3 rounded-box border border-base-200 bg-base-100 p-4">
        <%= hidden_field_tag "surgery[patient_diagnosis_ids][]", "" %>
        <% patient_diagnoses.each do |entry| %>
          <label class="label cursor-pointer justify-start gap-3 rounded-xl border border-base-200 px-4 py-3 has-checked:border-primary has-checked:bg-primary/5" data-surgery-diagnosis-link-filter-target="diagnosisOption" data-patient-id="<%= entry.patient_id %>">
            <%= check_box_tag "surgery[patient_diagnosis_ids][]", entry.id, surgery.patient_diagnosis_ids.include?(entry.id), class: "checkbox checkbox-primary" %>
            <span class="label-text"><%= "#{entry.patient.hospital_id} - #{entry.patient.name} / #{entry.display_name} (#{entry.diagnosed_on.strftime("%Y-%m-%d")})" %></span>
          </label>
        <% end %>

        <div class="app-empty-state hidden" data-surgery-diagnosis-link-filter-target="emptyState">
          No diagnoses are registered for the selected patient.
        </div>
      </div>
    <% else %>
      <div class="app-empty-state">
        No diagnoses available. Register diagnoses for a patient first.
      </div>
    <% end %>

    <p class="app-helper">Only diagnoses belonging to the selected patient can be saved.</p>
  </div>

  <div class="app-field">
    <%= form.label :surgery_date, "Surgery Date", class: "app-field-label" %>
    <%= form.date_field :surgery_date, class: "input input-bordered w-full focus:input-primary" %>
  </div>

  <div class="space-y-4" data-controller="surgery-procedure-fields" data-surgery-procedure-fields-max-items-value="5" data-action="procedure:created@window->surgery-procedure-fields#addProcedureOption">
    <div class="flex items-center justify-between gap-3">
      <div>
        <span class="app-field-label">Procedures</span>
        <p class="app-helper">Add up to 5 procedures for one surgery.</p>
      </div>
      <%= link_to "New Procedure", new_surgery_procedure_path, class: "app-inline-link text-sm", data: { turbo_frame: "surgery_procedure_modal_frame" } %>
    </div>

    <div class="space-y-3" data-surgery-procedure-fields-target="list">
      <%= form.fields_for :surgery_procedure_selections do |selection_fields| %>
        <%= render "surgery_procedure_selection_fields", form: form, selection_fields: selection_fields, procedure_options: surgery_procedures %>
      <% end %>
    </div>

    <template data-surgery-procedure-fields-target="template">
      <%= form.fields_for :surgery_procedure_selections, SurgeryProcedureSelection.new, child_index: "NEW_RECORD" do |selection_fields| %>
        <%= render "surgery_procedure_selection_fields", form: form, selection_fields: selection_fields, procedure_options: surgery_procedures %>
      <% end %>
    </template>

    <div class="flex items-center justify-between gap-3">
      <span class="app-helper">If the right procedure is not listed, create a new one first.</span>
      <button type="button" class="btn btn-outline btn-sm" data-surgery-procedure-fields-target="addButton" data-action="surgery-procedure-fields#add">Add Procedure</button>
    </div>
  </div>

  <div class="app-field">
    <%= form.label :duration_hours, "Duration (hours)", class: "app-field-label" %>
    <%= form.number_field :duration_hours, class: "input input-bordered w-full focus:input-primary", min: 0, step: :any, placeholder: "e.g. 1.5" %>
  </div>

  <div class="app-field">
    <%= form.label :anesthesia_method, "Anesthesia Method", class: "app-field-label" %>
    <%= form.text_field :anesthesia_method, class: "input input-bordered w-full focus:input-primary", placeholder: "e.g. General anesthesia" %>
  </div>

  <div class="pt-4">
    <%= form.submit class: "btn btn-primary w-full" %>
  </div>
<% end %>
