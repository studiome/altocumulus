<%= form_with(model: surgery, class: "space-y-6") do |form| %>
  <% if surgery.errors.any? %>
    <div role="alert" class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <h3 class="font-bold"><%= pluralize(surgery.errors.count, "error") %> prohibited this surgery from being saved:</h3>
        <ul class="list-disc ml-6">
          <% surgery.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% if defined?(@patients) && @patients.none? %>
    <div role="alert" class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div class="flex items-center justify-between w-full gap-4">
        <span>No patients found. Create a patient first to register a surgery.</span>
        <%= link_to "New Patient", new_patient_path, class: "btn btn-sm btn-outline" %>
      </div>
    </div>
  <% end %>

  <% if defined?(@surgery_procedures) && @surgery_procedures.none? %>
    <div role="alert" class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div class="flex items-center justify-between w-full gap-4">
        <span>No procedure names found. Create a procedure master first, or open the new procedure screen.</span>
        <%= link_to "New Procedure", new_surgery_procedure_path, class: "btn btn-sm btn-outline" %>
      </div>
    </div>
  <% end %>

  <div class="form-control w-full">
    <%= form.label :patient_id, class: "label" do %>
      <span class="label-text font-semibold text-base">Patient</span>
    <% end %>
    <% patient_options = defined?(@patients) ? @patients.map { |p| [ "#{p.hospital_id} - #{p.name}", p.id ] } : [] %>
    <%= form.select :patient_id, patient_options, { prompt: "Select a patient" }, class: "select select-bordered w-full focus:select-primary" %>
  </div>

  <div class="form-control w-full">
    <%= form.label :surgery_date, class: "label" do %>
      <span class="label-text font-semibold text-base">Surgery Date</span>
    <% end %>
    <%= form.date_field :surgery_date, class: "input input-bordered w-full focus:input-primary" %>
  </div>

  <div class="form-control w-full">
    <%= form.label :laterality, class: "label" do %>
      <span class="label-text font-semibold text-base">Laterality</span>
    <% end %>
    <% laterality_options = [["Right", "right"], ["Left", "left"], ["Bilateral", "bilateral"], ["None", "none"]] %>
    <%= form.select :laterality, laterality_options, {}, class: "select select-bordered w-full focus:select-primary" %>
  </div>

  <div class="form-control w-full">
    <%= form.label :procedure, class: "label" do %>
      <span class="label-text font-semibold text-base">Procedure</span>
    <% end %>
    <% procedure_options = defined?(@surgery_procedures) ? @surgery_procedures.map { |procedure| [procedure.name, procedure.name] } : [] %>
    <%= form.select :procedure, procedure_options, { prompt: "Select a procedure" }, class: "select select-bordered w-full focus:select-primary" %>
    <div class="mt-2 flex items-center justify-between gap-3 text-sm">
      <span class="text-base-content/60">If the right procedure is not listed, create a new one first.</span>
      <%= link_to "New Procedure", new_surgery_procedure_path, class: "btn btn-link no-underline px-0" %>
    </div>
  </div>

  <div class="form-control w-full">
    <%= form.label :duration_hours, class: "label" do %>
      <span class="label-text font-semibold text-base">Duration (hours)</span>
    <% end %>
    <%= form.number_field :duration_hours, class: "input input-bordered w-full focus:input-primary", min: 0, step: :any, placeholder: "e.g. 1.5" %>
  </div>

  <div class="form-control w-full">
    <%= form.label :anesthesia_method, class: "label" do %>
      <span class="label-text font-semibold text-base">Anesthesia Method</span>
    <% end %>
    <%= form.text_field :anesthesia_method, class: "input input-bordered w-full focus:input-primary", placeholder: "e.g. General anesthesia" %>
  </div>

  <div class="pt-4">
    <%= form.submit class: "btn btn-primary w-full" %>
  </div>
<% end %>

