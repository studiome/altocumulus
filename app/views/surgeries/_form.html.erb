<%= form_with(model: surgery, class: "app-form", data: { controller: "surgery-patient-fields surgery-slot-category", surgery_patient_fields_url_value: patient_fields_surgeries_path }) do |form| %>
  <% if surgery.errors.any? %>
    <div role="alert" class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <h3 class="font-bold"><%= t(".errors_heading", count: surgery.errors.count) %></h3>
        <ul class="list-disc ml-6">
          <% surgery.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% if patients.none? %>
    <div role="alert" class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div class="flex items-center justify-between w-full gap-4">
        <span><%= t(".no_patients_warning") %></span>
        <%= link_to t(".new_patient_link"), new_patient_path, class: "btn btn-sm btn-outline" %>
      </div>
    </div>
  <% end %>

  <% if surgery_procedures.none? %>
    <div role="alert" class="alert alert-warning">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <div class="flex items-center justify-between w-full gap-4">
        <span><%= t(".no_procedures_warning") %></span>
        <%= link_to t(".new_procedure_link"), new_surgery_procedure_path, class: "btn btn-sm btn-outline", data: { turbo_frame: "surgery_procedure_picker_frame" } %>
      </div>
    </div>
  <% end %>

  <%# Set when the surgery follows from a hospitalization (see
      HospitalizationsController#redirect_after_create); not user-editable here. %>
  <%= form.hidden_field :hospitalization_id %>

  <%= render "shared/patient_picker_field", form: form, patient: surgery.patient,
        label: Surgery.human_attribute_name(:patient_id),
        input_data: { action: "change->surgery-patient-fields#reload" } %>

  <%= render "patient_scoped_fields",
        patient_selected: surgery.patient_id.present?,
        patient_id: surgery.patient_id,
        patient_diagnoses: patient_diagnoses,
        selected_patient_diagnosis_ids: surgery.patient_diagnosis_ids %>

  <div class="app-field">
    <span class="app-field-label"><%= t("surgeries.labels.surgery_date") %></span>
    <div class="flex gap-6 pt-1">
      <% Surgery.surgery_date_status_options.each do |value, label| %>
        <label class="flex items-center gap-2 cursor-pointer">
          <%= form.radio_button :surgery_date_status, value, checked: surgery.surgery_date_status == value, class: "radio radio-primary" %>
          <%= label %>
        </label>
      <% end %>
    </div>
    <%= form.date_field :surgery_date, class: "input w-full focus:input-primary mt-2" %>
    <p class="app-helper"><%= t(".surgery_date_helper") %></p>
  </div>

  <div class="app-field">
    <span class="app-field-label"><%= t(".scheduling_type_label") %></span>
    <div class="flex gap-6 pt-1">
      <label class="flex items-center gap-2 cursor-pointer">
        <%= form.radio_button :scheduling_type, "elective", class: "radio radio-primary", data: { surgery_slot_category_target: "schedulingTypeRadio", action: "change->surgery-slot-category#toggle" } %>
        <%= Surgery.scheduling_type_options["elective"] %>
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <%= form.radio_button :scheduling_type, "emergency", class: "radio radio-primary", data: { surgery_slot_category_target: "schedulingTypeRadio", action: "change->surgery-slot-category#toggle" } %>
        <%= Surgery.scheduling_type_options["emergency"] %>
      </label>
    </div>
  </div>

  <div class="app-field">
    <span class="app-field-label"><%= t(".slot_category_label") %></span>
    <%# Two columns at most: the form sits in a max-w-xl card, and a category
        name like "Joint/Simultaneous Surgery" does not fit a quarter of that.
        Plain flex rather than daisyUI's .label, whose nowrap would push a long
        name out over the next option instead of wrapping it. %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
      <% Surgery.slot_category_options.each do |value, label| %>
        <label class="flex items-center gap-2 cursor-pointer rounded-xl border border-base-200 px-3 py-2.5 has-checked:border-primary has-checked:bg-primary/5">
          <%= form.radio_button :slot_category, value, checked: surgery.slot_category == value, class: "radio radio-primary radio-sm shrink-0", data: { surgery_slot_category_target: "categoryRadio", action: "change->surgery-slot-category#toggle" } %>
          <span class="text-sm font-medium"><%= label %></span>
        </label>
      <% end %>
    </div>
    <p class="app-helper"><%= t(".slot_category_helper") %></p>
  </div>

  <div class="app-field hidden" data-surgery-slot-category-target="targetDepartmentSection">
    <%= form.label :department_id, t(".target_department_label"), class: "app-field-label" %>
    <%= form.collection_select :department_id, Department.choices_for(surgery.department_id), :id, :name,
                               { include_blank: true }, { class: "select w-full focus:select-primary" } %>
    <p class="app-helper"><%= t(".target_department_helper") %></p>
  </div>

  <div class="app-field hidden" data-surgery-slot-category-target="backupInterventionSection">
    <span class="app-field-label app-field-label-required"><%= t(".backup_intervention_label") %></span>
    <div class="flex gap-6 pt-1">
      <% Surgery.backup_intervention_options.each do |value, label| %>
        <label class="flex items-center gap-2 cursor-pointer">
          <%= form.radio_button :backup_intervention, value, class: "radio radio-primary" %>
          <%= label %>
        </label>
      <% end %>
    </div>
    <p class="app-helper"><%= t(".backup_intervention_helper") %></p>
  </div>

  <div class="app-field hidden" data-surgery-slot-category-target="locationSection">
    <%= form.label :surgery_location_id, t(".location_label"), class: "app-field-label" %>
    <%= form.collection_select :surgery_location_id, SurgeryLocation.choices_for(surgery.surgery_location_id), :id, :name,
                               { include_blank: true }, { class: "select w-full focus:select-primary" } %>
    <p class="app-helper"><%= t(".location_helper") %></p>
  </div>

  <div class="app-field">
    <%= form.label :performing_department_id, t(".performing_department_label"), class: "app-field-label" %>
    <%= form.collection_select :performing_department_id, Department.choices_for(surgery.performing_department_id), :id, :name,
                               { include_blank: true }, { class: "select w-full focus:select-primary" } %>
    <p class="app-helper"><%= t(".performing_department_helper") %></p>
  </div>

  <%= render "shared/team_field", form: form, record: surgery, helper_text: t(".team_helper") %>

  <div class="app-field">
    <%= form.label :surgical_device_id, t(".surgical_device_label"), class: "app-field-label" %>
    <%= form.collection_select :surgical_device_id, SurgicalDevice.choices_for(surgery.surgical_device_id), :id, :name,
                               { include_blank: true }, { class: "select w-full focus:select-primary" } %>
    <p class="app-helper"><%= t(".surgical_device_helper") %></p>
  </div>

  <div class="app-field">
    <%= form.label :start_time, t("surgeries.labels.start_time"), class: "app-field-label" %>
    <%= form.time_field :start_time, class: "input w-full focus:input-primary" %>
    <p class="app-helper"><%= t(".start_time_helper") %></p>
  </div>

  <div class="space-y-4" data-surgery-slot-category-target="slotNumberSection">
    <div class="app-field">
      <%= form.label :slot_number, t(".slot_number_label"), class: "app-field-label" %>
      <%= form.number_field :slot_number, class: "input w-full focus:input-primary", min: 1, step: 1, placeholder: t(".slot_number_placeholder") %>
      <p class="app-helper">
        <%= t(".slot_number_helper") %>
        <% if elective_slot_rules.present? %>
          <br>
          <%= t(".configured_slots_prefix") %>
          <%= elective_slot_rules.map { |rule| "#{rule.day_name}: #{rule.total_slots}" }.join(", ") %>.
        <% end %>
      </p>
    </div>

    <div class="rounded-box border border-base-200 bg-base-100 p-4 space-y-2">
      <div class="flex items-center justify-between gap-3">
        <span class="text-sm font-semibold"><%= t(".slot_rules_heading") %></span>
        <%= link_to t(".manage_slot_rules_link"), elective_slot_rules_path, class: "app-inline-link text-sm" %>
      </div>
      <% if elective_slot_rules.any? %>
        <ul class="text-sm text-base-content/60 space-y-1">
          <% elective_slot_rules.each do |rule| %>
            <li><%= rule.to_s %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="app-helper"><%= t(".no_slot_rules") %></p>
      <% end %>
    </div>
  </div>

  <div class="space-y-4" data-controller="surgery-procedure-fields" data-surgery-procedure-fields-max-items-value="5">
    <div class="flex items-center justify-between gap-3">
      <div>
        <span class="app-field-label"><%= t("surgeries.labels.procedures") %></span>
        <p class="app-helper"><%= t(".procedures_helper") %></p>
      </div>
    </div>

    <div class="space-y-3" data-surgery-procedure-fields-target="list">
      <%= form.fields_for :surgery_procedure_selections do |selection_fields| %>
        <%= render "surgery_procedure_selection_fields", selection_fields: selection_fields %>
      <% end %>
    </div>

    <template data-surgery-procedure-fields-target="template">
      <%= form.fields_for :surgery_procedure_selections, SurgeryProcedureSelection.new, child_index: "NEW_RECORD" do |selection_fields| %>
        <%= render "surgery_procedure_selection_fields", selection_fields: selection_fields %>
      <% end %>
    </template>

    <div class="flex items-center justify-between gap-3">
      <span class="app-helper"><%= t(".procedure_row_helper") %></span>
      <button type="button" class="btn btn-outline btn-sm" data-surgery-procedure-fields-target="addButton" data-action="surgery-procedure-fields#add"><%= t(".add_procedure_button") %></button>
    </div>
  </div>

  <div class="app-field">
    <%= form.label :duration_hours, t(".duration_label"), class: required_label_class(Surgery, :duration_hours) %>
    <%= form.number_field :duration_hours, class: "input w-full focus:input-primary", min: 0, step: :any, placeholder: t(".duration_placeholder") %>
  </div>

  <div class="app-field">
    <%= form.label :anesthesia_method, t(".anesthesia_method_label"), class: "app-field-label" %>
    <%= form.text_field :anesthesia_method, class: "input w-full focus:input-primary", placeholder: t(".anesthesia_method_placeholder") %>
  </div>

  <div class="app-field">
    <%= form.label :operator_name, t("surgeries.labels.operator"), class: required_label_class(Surgery, :operator_name) %>
    <%= form.text_field :operator_name, class: "input w-full focus:input-primary", placeholder: t(".operator_placeholder") %>
  </div>

  <div class="app-field">
    <%= form.label :assistant_name, t("surgeries.labels.assistant"), class: "app-field-label" %>
    <%= form.text_field :assistant_name, class: "input w-full focus:input-primary", placeholder: t(".assistant_placeholder") %>
  </div>

  <div class="app-field">
    <%= form.label :operation_order, t("surgeries.labels.operation_order"), class: "app-field-label" %>
    <%= form.number_field :operation_order, class: "input w-full focus:input-primary", min: 1, step: 1, placeholder: t(".operation_order_placeholder") %>
  </div>

  <div class="pt-4">
    <%= form.submit class: "btn btn-primary w-full" %>
  </div>
<% end %>
