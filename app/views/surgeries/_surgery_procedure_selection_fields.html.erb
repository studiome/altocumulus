<div class="rounded-box border border-base-200 bg-base-100 p-4 space-y-3" data-surgery-procedure-fields-target="item">
  <%= selection_fields.hidden_field :_destroy, data: { surgery_procedure_fields_target: "destroyField" } %>
  <% if selection_fields.object.persisted? %>
    <%= selection_fields.hidden_field :id %>
  <% end %>

  <div class="space-y-4">
    <div class="app-field">
      <%= selection_fields.label :laterality, SurgeryProcedureSelection.human_attribute_name(:laterality), class: "app-field-label" %>
      <%= selection_fields.select :laterality, SurgeryProcedureSelection.laterality_form_options, {}, class: "select w-full focus:select-primary" %>
    </div>

    <%= render "shared/picker_field",
          form: selection_fields,
          attribute: :surgery_procedure_id,
          label: t(".procedure_label"),
          selected_label: selection_fields.object.surgery_procedure&.name,
          placeholder: t("surgery_procedures.picker.unselected"),
          picker_path: picker_surgery_procedures_path,
          picker_frame: "surgery_procedure_picker_frame",
          choose_label: t("surgery_procedures.picker.choose_button"),
          event_name: "procedure:picked" %>
  </div>

  <div class="flex justify-end">
    <button type="button" class="btn btn-ghost btn-sm" data-action="surgery-procedure-fields#remove"><%= t(".remove_button") %></button>
  </div>
</div>
