<% content_for :title, t(".title") %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= t(".kicker") %></p>
        <h1 class="app-page-title"><%= t(".title") %></h1>
      </div>
      <%= link_to new_surgery_path, class: "btn btn-primary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        <%= t(".new_button") %>
      <% end %>
    </div>
  </section>

  <%= form_with url: surgeries_path, method: :get, local: true, class: "app-filter-bar" do |f| %>
    <div class="app-filter-field">
      <label class="app-filter-label"><%= t(".keyword_label") %></label>
      <%= f.text_field :keyword, value: params[:keyword], placeholder: t(".keyword_placeholder"), class: "input input-sm" %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label"><%= t(".procedure_label") %></label>
      <%= f.select :surgery_procedure_id, @surgery_procedures.map { |p| [ p.name, p.id ] }, { include_blank: t(".all_option"), selected: params[:surgery_procedure_id] }, { class: "select select-sm" } %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label"><%= t("surgeries.labels.anesthesia") %></label>
      <%= f.select :anesthesia_method, @anesthesia_methods, { include_blank: t(".all_option"), selected: params[:anesthesia_method] }, { class: "select select-sm" } %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label"><%= t(".type_label") %></label>
      <%= f.select :scheduling_type, Surgery.scheduling_type_form_options, { include_blank: t(".all_option"), selected: params[:scheduling_type] }, { class: "select select-sm" } %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label"><%= t("surgeries.labels.slot_category") %></label>
      <%= f.select :slot_category, Surgery.slot_category_form_options, { include_blank: t(".all_option"), selected: params[:slot_category] }, { class: "select select-sm" } %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label"><%= t(".performed_from_label") %></label>
      <%= f.date_field :performed_from, value: params[:performed_from], class: "input input-sm" %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label"><%= t(".performed_to_label") %></label>
      <%= f.date_field :performed_to, value: params[:performed_to], class: "input input-sm" %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label"><%= t("models.surgery.surgery_date_display_undated") %></label>
      <label class="label cursor-pointer justify-start gap-2 py-0">
        <%= f.check_box :undated, { checked: ActiveModel::Type::Boolean.new.cast(params[:undated]), class: "checkbox checkbox-sm" }, "1", "0" %>
        <span class="text-sm"><%= t(".undated_checkbox_label") %></span>
      </label>
    </div>
    <%= f.submit t("common.search"), class: "btn btn-primary btn-sm" %>
    <% if params.values_at(:keyword, :surgery_procedure_id, :anesthesia_method, :performed_from, :performed_to, :scheduling_type, :slot_category, :undated).any?(&:present?) %>
      <%= link_to t("common.clear"), surgeries_path, class: "btn btn-ghost btn-sm" %>
    <% end %>
  <% end %>

  <div class="app-panel overflow-hidden">
    <div class="overflow-x-auto">
      <table class="app-ledger">
        <thead>
          <tr>
            <th><span class="block"><%= t("surgeries.labels.surgery_date") %></span><span class="block"><%= t("surgeries.labels.start_time") %></span></th>
            <th><%= Surgery.human_attribute_name(:patient_id) %></th>
            <th><span class="block"><%= t(".diagnosis_header") %></span><span class="block"><%= t("surgeries.labels.procedures") %></span></th>
            <th><span class="block"><%= t("surgeries.labels.operator") %></span><span class="block"><%= t("surgeries.labels.assistant") %></span></th>
            <th><%= t(".type_label") %></th>
            <th><span class="block"><%= t("surgeries.labels.duration") %></span><span class="block"><%= t("surgeries.labels.anesthesia") %></span></th>
            <th class="text-center"><%= t("common.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% if @surgeries.any? %>
            <% @surgeries.each do |surgery| %>
              <% slot_rule = @slot_rules[surgery.surgery_date&.wday] %>
              <tr class="row-hover <%= "ledger-row-urgent" if surgery.emergency? %>">
                <td class="whitespace-nowrap">
                  <span class="ledger-primary font-mono">
                    <% if surgery.surgery_date %>
                      <%= l(surgery.surgery_date, format: :default) %>
                    <% else %>
                      <span class="badge badge-ghost badge-sm"><%= t("models.surgery.surgery_date_display_undated") %></span>
                    <% end %>
                  </span>
                  <span class="ledger-secondary font-mono"><%= surgery.start_time_display %></span>
                </td>
                <td class="ledger-patient">
                  <% if surgery.patient %>
                    <span class="ledger-secondary font-mono"><%= surgery.patient.hospital_id %></span>
                    <%= link_to surgery.patient.name.presence || t("surgeries.labels.unknown_patient_name", id: surgery.patient_id), surgery.patient, class: "ledger-primary app-inline-link" %>
                  <% else %>
                    <span class="ledger-secondary italic"><%= t("surgeries.labels.unknown_patient") %></span>
                    <span class="ledger-primary"></span>
                  <% end %>
                </td>
                <td>
                  <span class="ledger-secondary"><%= surgery.diagnosis_names_display %></span>
                  <span class="ledger-primary leading-snug"><%= surgery.display_procedure_name %></span>
                  <% if surgery.elective? && surgery.regular_slot? %>
                    <% if surgery.slot_number %>
                      <span class="badge badge-ghost badge-sm mt-1">
                        <% if slot_rule %>
                          <%= t(".slot_badge_with_total", number: surgery.slot_number, total: slot_rule.total_slots) %>
                        <% else %>
                          <%= t(".slot_badge", number: surgery.slot_number) %>
                        <% end %>
                      </span>
                    <% else %>
                      <span class="badge badge-warning badge-sm mt-1"><%= t("surgeries.labels.no_slot_assigned") %></span>
                    <% end %>
                  <% end %>
                </td>
                <td class="ledger-operator">
                  <span class="ledger-primary"><%= surgery.operator_name.presence || t("common.none") %></span>
                  <% if surgery.assistant_name.present? %>
                    <span class="ledger-secondary"><%= surgery.assistant_name %></span>
                  <% end %>
                </td>
                <td>
                  <div class="flex flex-col gap-1 items-start">
                    <span class="badge badge-sm <%= surgery.emergency? ? "badge-error" : "badge-ghost" %>"><%= surgery.scheduling_type_label %></span>
                    <% unless surgery.regular_slot? %>
                      <span class="badge <%= surgery.slot_category_badge_class %> badge-xs whitespace-nowrap">
                        <%= surgery.slot_category_label %><% if surgery.target_department.present? %>: <%= surgery.target_department %><% elsif surgery.location.present? %>: <%= surgery.location %><% end %>
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="whitespace-nowrap">
                  <span class="ledger-primary"><%= surgery.duration_hours.present? ? t("surgeries.labels.duration_value", hours: surgery.duration_hours) : t("common.none") %></span>
                  <span class="ledger-secondary"><%= surgery.anesthesia_method %></span>
                </td>
                <td class="ledger-actions">
                  <%= link_to t("common.view"), surgery, class: "app-inline-link" %>
                  <%= link_to t("common.edit"), edit_surgery_path(surgery), class: "app-inline-link" %>
                  <%= button_to t("common.delete"), surgery, method: :delete, class: "app-inline-link text-error", data: { turbo_confirm: t("common.confirm_delete") } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center py-10 text-base-content/50 italic">
                <% if params.values_at(:keyword, :surgery_procedure_id, :anesthesia_method, :performed_from, :performed_to, :scheduling_type, :undated).any?(&:present?) %>
                  <%= t(".empty_filtered") %>
                <% else %>
                  <%= t(".empty_no_filter") %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= render "shared/pagination", pagination: @pagination %>
</div>
