<% content_for :title, "Surgeries" %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker">Operations</p>
        <h1 class="app-page-title">Surgeries</h1>
      </div>
      <%= link_to new_surgery_path, class: "btn btn-primary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        New Surgery
      <% end %>
    </div>
  </section>

  <%= form_with url: surgeries_path, method: :get, local: true, class: "app-filter-bar" do |f| %>
    <div class="app-filter-field">
      <label class="app-filter-label">Keyword</label>
      <%= f.text_field :keyword, value: params[:keyword], placeholder: "Patient name or Hospital ID", class: "input input-sm" %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label">Procedure</label>
      <%= f.select :surgery_procedure_id, @surgery_procedures.map { |p| [ p.name, p.id ] }, { include_blank: "All", selected: params[:surgery_procedure_id] }, { class: "select select-sm" } %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label">Anesthesia</label>
      <%= f.select :anesthesia_method, @anesthesia_methods, { include_blank: "All", selected: params[:anesthesia_method] }, { class: "select select-sm" } %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label">Type</label>
      <%= f.select :scheduling_type, Surgery.scheduling_type_form_options, { include_blank: "All", selected: params[:scheduling_type] }, { class: "select select-sm" } %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label">Performed From</label>
      <%= f.date_field :performed_from, value: params[:performed_from], class: "input input-sm" %>
    </div>
    <div class="app-filter-field">
      <label class="app-filter-label">Performed To</label>
      <%= f.date_field :performed_to, value: params[:performed_to], class: "input input-sm" %>
    </div>
    <%= f.submit "Search", class: "btn btn-primary btn-sm" %>
    <% if params.values_at(:keyword, :surgery_procedure_id, :anesthesia_method, :performed_from, :performed_to, :scheduling_type).any?(&:present?) %>
      <%= link_to "Clear", surgeries_path, class: "btn btn-ghost btn-sm" %>
    <% end %>
  <% end %>

  <div class="app-panel overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th class="bg-base-200">Surgery Date</th>
            <th class="bg-base-200">Type</th>
            <th class="bg-base-200">Start Time</th>
            <th class="bg-base-200">Diagnosis</th>
            <th class="bg-base-200">Procedures</th>
            <th class="bg-base-200">Duration</th>
            <th class="bg-base-200">Anesthesia</th>
            <th class="bg-base-200">Patient</th>
            <th class="bg-base-200">Hospitalization</th>
            <th class="bg-base-200 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @surgeries.any? %>
            <% @surgeries.each do |surgery| %>
              <% slot_rule = @slot_rules[surgery.surgery_date&.wday] %>
              <tr class="row-hover">
                <td class="font-mono font-medium"><%= surgery.surgery_date&.strftime("%Y-%m-%d") %></td>
                <td>
                  <span class="badge <%= surgery.emergency? ? "badge-error" : "badge-ghost" %>"><%= surgery.scheduling_type_label %></span>
                </td>
                <td class="font-mono"><%= surgery.start_time_display %></td>
                <td><%= surgery.diagnosis_names_display %></td>
                <td>
                  <div class="font-semibold leading-snug"><%= surgery.display_procedure_name %></div>
                  <% if surgery.elective? %>
                    <% if surgery.slot_number %>
                      <span class="badge badge-ghost badge-sm mt-1">Slot <%= surgery.slot_number %><% if slot_rule %> / <%= slot_rule.slot_count %><% end %></span>
                    <% else %>
                      <span class="badge badge-warning badge-sm mt-1">No slot assigned</span>
                    <% end %>
                  <% end %>
                </td>
                <td><%= surgery.duration_hours.present? ? "#{surgery.duration_hours} h" : "-" %></td>
                <td><%= surgery.anesthesia_method %></td>
                <td>
                  <% if surgery.patient %>
                    <%= link_to surgery.patient.name.presence || "Patient ##{surgery.patient_id}", surgery.patient, class: "link link-primary" %>
                    <span class="text-base-content/50 text-sm font-mono ml-2"><%= surgery.patient.hospital_id %></span>
                  <% else %>
                    <span class="text-base-content/50 italic">Unknown</span>
                  <% end %>
                </td>
                <td>
                  <% if surgery.hospitalization %>
                    <%= link_to surgery.hospitalization.admission_date&.strftime("%Y-%m-%d"), surgery.hospitalization, class: "link link-primary" %>
                  <% else %>
                    <span class="text-base-content/50 italic">Standalone</span>
                  <% end %>
                </td>
                <td class="text-right flex justify-end gap-2">
                  <%= link_to "View", surgery, class: "btn btn-ghost btn-xs text-primary" %>
                  <%= link_to "Edit", edit_surgery_path(surgery), class: "btn btn-ghost btn-xs text-secondary" %>
                  <%= button_to "Delete", surgery, method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: "Are you sure?" } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="10" class="text-center py-10 text-base-content/50 italic">
                <% if params.values_at(:keyword, :surgery_procedure_id, :anesthesia_method, :performed_from, :performed_to, :scheduling_type).any?(&:present?) %>
                  No surgeries match your search.
                <% else %>
                  No surgeries found. Click "New Surgery" to get started.
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= render "shared/pagination", pagination: @pagination %>
</div>
