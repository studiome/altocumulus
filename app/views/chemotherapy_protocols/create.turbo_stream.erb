<%= turbo_stream.replace "chemotherapy_protocol_picker_frame" do %>
  <%= turbo_frame_tag "chemotherapy_protocol_picker_frame", data: { action: "turbo:frame-load->picker-modal#open" } do %>
    <div class="p-6 text-center"
         data-controller="picker-result"
         data-picker-result-event-value="protocol:picked"
         data-picker-autoselect="true"
         data-picker-id="<%= @record.id %>"
         data-picker-label="<%= @record.name %>">
      <div class="alert alert-success justify-start mb-4">
        <span><%= t("chemotherapy_protocols.picker.created_notice") %></span>
      </div>
      <p class="text-sm text-base-content/60"><%= t("chemotherapy_protocols.picker.added_helper_text") %></p>
    </div>
  <% end %>
<% end %>
