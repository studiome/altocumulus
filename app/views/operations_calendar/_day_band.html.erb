<%# The band above a day: its note frame in a full-width row. Administrators
    always get the (possibly empty, then hidden) row, because the "add note"
    link in the day cell opens its editor there. The content sits in
    .ledger-band-content, which stays in view while the page scrolls sideways. %>
<% if usage_holiday || admin? %>
  <tr class="ledger-band ledger-note-row"><td colspan="<%= columns %>"><div class="ledger-band-content"><%= day_note_frame(date, usage_holiday, context) %></div></td></tr>
<% end %>
