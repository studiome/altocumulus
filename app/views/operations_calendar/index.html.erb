<% content_for :title, t(".title") %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= t(".kicker") %></p>
        <h1 class="app-page-title"><%= t(".title") %></h1>
        <p class="text-base-content/60 mt-1">
          <%= l(@calendar.dates.first, format: :long) %> &ndash; <%= l(@calendar.dates.last, format: :long) %>
          (<%= t(".days_count", count: @calendar.days) %>)
        </p>
      </div>
      <%= form_with url: operations_calendar_path, method: :get, local: true, class: "flex items-end gap-2 flex-wrap print:hidden" do |f| %>
        <div class="app-filter-field">
          <label class="app-filter-label"><%= t(".start_label") %></label>
          <%= f.date_field :start, value: @calendar.start_date, class: "input input-sm" %>
        </div>
        <div class="app-filter-field">
          <label class="app-filter-label"><%= t(".days_label") %></label>
          <%= f.number_field :days, value: @calendar.days, min: 1, max: OperationsCalendar::MAX_DAYS, class: "input input-sm w-24" %>
        </div>
        <%= f.submit t(".apply_submit"), class: "btn btn-primary btn-sm" %>
        <%= link_to t(".today_link"), operations_calendar_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    </div>
  </section>

  <% if @calendar.announcements.any? %>
    <div class="space-y-2">
      <% @calendar.announcements.each do |announcement| %>
        <div role="alert" class="alert alert-info items-start">
          <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <div>
            <h3 class="font-bold"><%= announcement.title %></h3>
            <p class="text-sm"><%= announcement.body %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="app-panel overflow-hidden print:overflow-visible">
    <div class="overflow-x-auto">
      <%# One ledger table for the whole range: each day is its own <tbody>
          (see _day), so the day cell can span that day's surgery rows. %>
      <table class="app-ledger oc-ledger">
        <thead>
          <tr>
            <th><%= t("surgeries.labels.surgery_date") %></th>
            <th><span class="block"><%= t("surgeries.labels.start_time") %></span><span class="block"><%= t(".slot_header") %></span></th>
            <th><%= Surgery.human_attribute_name(:patient_id) %></th>
            <th><span class="block"><%= t("surgeries.index.diagnosis_header") %></span><span class="block"><%= t("surgeries.labels.procedures") %></span></th>
            <th><span class="block"><%= t("surgeries.labels.operator") %></span><span class="block"><%= t("surgeries.labels.assistant") %></span></th>
            <th><span class="block"><%= t("surgeries.labels.duration") %></span><span class="block"><%= t("surgeries.labels.anesthesia") %></span></th>
            <th><%= t("surgeries.index.type_label") %></th>
          </tr>
        </thead>
        <% @calendar.dates.each_with_index do |date, index| %>
          <%= render "day", date: date, usage: @calendar.slot_usages[date], calendar: @calendar, alternate: index.odd? %>
        <% end %>
      </table>
    </div>
  </div>
</div>
