<%# locals: row (Reservation::ProcedureRow), index (Integer, or NEW_RECORD for the template) %>
<%= fields_for "reservation[procedures][#{index}]", row do |pf| %>
  <div class="rounded-box border border-base-200 bg-base-100 p-4 space-y-3" data-surgery-procedure-fields-target="item">
    <%= pf.hidden_field :_destroy, data: { surgery_procedure_fields_target: "destroyField" } %>
    <% if row.persisted? %>
      <%= pf.hidden_field :id %>
    <% end %>

    <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_12rem]">
      <%= render "shared/picker_field",
            form: pf,
            attribute: :surgery_procedure_id,
            label: t("surgeries.surgery_procedure_selection_fields.procedure_label"),
            selected_label: row.surgery_procedure&.name,
            placeholder: t("surgery_procedures.picker.unselected"),
            picker_path: picker_surgery_procedures_path,
            picker_frame: "surgery_procedure_picker_frame",
            choose_label: t("surgery_procedures.picker.choose_button"),
            event_name: "procedure:picked" %>

      <div class="app-field">
        <%= pf.label :laterality, SurgeryProcedureSelection.human_attribute_name(:laterality), class: "app-field-label" %>
        <%= pf.select :laterality, SurgeryProcedureSelection.laterality_form_options, {}, class: "select w-full focus:select-primary" %>
      </div>
    </div>

    <div class="flex justify-end">
      <button type="button" class="btn btn-ghost btn-sm" data-action="surgery-procedure-fields#remove"><%= t("surgeries.surgery_procedure_selection_fields.remove_button") %></button>
    </div>
  </div>
<% end %>
