<%# locals: calendar (AdmissionCalendar), selected (nilable Date)

    A month of scheduled admission counts. Days above the warning threshold are
    marked, the selected admission date is ringed; the arrows reload only this
    turbo-frame. %>
<%= turbo_frame_tag "reservation_admission_calendar", data: { reservation_form_target: "calendarFrame" } do %>
  <div class="flex items-center justify-between gap-2 mb-2">
    <%= link_to admission_calendar_reservations_path(month: calendar.previous_month.strftime("%Y-%m"), selected: selected&.iso8601),
          class: "btn btn-ghost btn-sm btn-square", aria: { label: t("reservations.calendar.previous_month") } do %>
      <span aria-hidden="true">&lsaquo;</span>
    <% end %>
    <h3 class="font-semibold"><%= t("reservations.calendar.month_title", year: calendar.month.year, month: calendar.month.month) %></h3>
    <%= link_to admission_calendar_reservations_path(month: calendar.next_month.strftime("%Y-%m"), selected: selected&.iso8601),
          class: "btn btn-ghost btn-sm btn-square", aria: { label: t("reservations.calendar.next_month") } do %>
      <span aria-hidden="true">&rsaquo;</span>
    <% end %>
  </div>
  <table class="w-full text-center text-sm table-fixed" data-testid="admission-calendar">
    <thead>
      <tr>
        <% t("date.abbr_day_names").each do |name| %>
          <th scope="col" class="py-1 font-medium text-base-content/60"><%= name %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% calendar.weeks.each do |week| %>
        <tr>
          <% week.each do |date| %>
            <% count = calendar.count_for(date) %>
            <% classes = [ "rounded py-1" ] %>
            <% classes << "text-base-content/30" unless calendar.in_month?(date) %>
            <% classes << "bg-warning/30 font-bold" if calendar.over_threshold?(date) %>
            <% classes << "ring-2 ring-primary" if date == selected %>
            <td class="p-0.5">
              <div class="<%= classes.join(" ") %>" title="<%= t("reservations.calendar.day_title", date: l(date, format: :default), count: count) %>">
                <span class="block leading-tight"><%= date.day %></span>
                <span class="block text-xs leading-tight <%= count.zero? ? "text-base-content/20" : "font-mono" %>"><%= count.zero? ? "·" : count %></span>
              </div>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p class="app-helper mt-2"><%= t("reservations.calendar.legend", threshold: calendar.threshold) %></p>
<% end %>
