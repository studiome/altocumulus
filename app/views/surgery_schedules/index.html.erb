<% content_for :title, t(".title") %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= t(".kicker") %></p>
        <h1 class="app-page-title"><%= t(".title") %></h1>
        <p class="text-base-content/60 mt-1">
          <%= t(".week_of", date: l(@week_start, format: :long)) %>
        </p>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to t(".prev_week_link"), surgery_schedule_path(week_of: @previous_week), class: "btn btn-sm" %>
        <%= link_to t(".this_week_link"), surgery_schedule_path, class: "btn btn-sm btn-ghost" %>
        <%= link_to t(".next_week_link"), surgery_schedule_path(week_of: @next_week), class: "btn btn-sm" %>
        <%= link_to t(".configure_slots_link"), elective_slot_rules_path, class: "btn btn-sm btn-outline" %>
        <%= link_to t(".holidays_link"), holidays_path, class: "btn btn-sm btn-outline" %>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-7 gap-4">
    <% @dates.each do |date| %>
      <% usage = @slot_usages[date] %>
      <div class="app-panel">
        <div class="app-panel-body space-y-4">
          <div>
            <p class="text-xs font-bold uppercase text-base-content/40"><%= l(date, format: :weekday) %></p>
            <p class="text-lg font-semibold"><%= l(date, format: :default) %></p>
            <% if usage.holiday? %>
              <span class="badge badge-secondary badge-sm mt-1"><%= usage.holiday.name %></span>
            <% end %>
            <p class="text-sm text-base-content/60">
              <% if usage.configured? %>
                <%= t(".slots_in_use", used: usage.used_slots, total: usage.total_slots) %>
                <span class="text-base-content/40">(<%= t(".minutes_in_use", used: usage.used_minutes, capacity: usage.capacity_minutes) %>)</span>
              <% elsif usage.holiday? %>
                <%= t(".no_slots_holiday") %>
              <% else %>
                <%= t(".no_slots_configured") %>
              <% end %>
            </p>
          </div>

          <% usage.warnings.each do |warning| %>
            <div role="alert" class="alert alert-warning py-2 text-xs"><span><%= warning %></span></div>
          <% end %>

          <%# A slot is a whole day of one operating room, so it lists every
              surgery booked into it and is flagged only when their combined
              time runs past the slot's duration. %>
          <div class="space-y-2">
            <% usage.slots.each do |slot| %>
              <div class="rounded-box border p-3 text-sm space-y-2 <%= slot.empty? ? "border-base-200 border-dashed bg-base-200/40" : slot.overrun? ? "border-warning/60 bg-warning/5" : "border-base-200 bg-base-100" %>">
                <%# Stacked rather than side by side: the week board gives each
                    day a narrow column, and a horizontal row wraps badly. %>
                <div>
                  <p class="text-xs font-bold uppercase text-base-content/40"><%= t(".slot_number_label", number: slot.number) %></p>
                  <p class="font-mono text-xs text-base-content/50 whitespace-nowrap"><%= t(".slot_minutes_label", used: slot.used_minutes, duration: slot.duration_minutes) %></p>
                </div>

                <% if slot.overrun? %>
                  <span class="badge badge-warning badge-sm whitespace-nowrap"><%= t(".overrun_badge", minutes: slot.overrun_minutes) %></span>
                <% end %>

                <% if slot.empty? %>
                  <span class="text-base-content/40 italic"><%= t(".slot_open") %></span>
                <% else %>
                  <div class="space-y-2">
                    <% slot.surgeries.each do |surgery| %>
                      <div class="rounded border border-base-200 bg-base-100 p-2">
                        <%= render "slot_surgery", surgery: surgery %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <% if usage.unscheduled_surgeries.any? %>
            <div class="space-y-2">
              <p class="text-xs font-bold uppercase text-error"><%= usage.configured? ? t(".not_assigned_to_slot") : t(".no_slot_available") %></p>
              <% usage.unscheduled_surgeries.each do |surgery| %>
                <div class="rounded-box border border-error/40 bg-error/5 p-3 text-sm">
                  <%= render "slot_surgery", surgery: surgery %>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if usage.simultaneous_surgeries.any? || usage.backup_surgeries.any? %>
            <div class="divider my-1 text-xs font-semibold uppercase text-info/70"><%= t(".other_departments_heading") %></div>
            <div class="space-y-2">
              <% (usage.simultaneous_surgeries + usage.backup_surgeries).each do |surgery| %>
                <div class="rounded-box border border-info/30 bg-info/5 p-2.5 text-sm">
                  <%= render "slot_surgery", surgery: surgery %>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if usage.off_slot_surgeries.any? %>
            <div class="divider my-1 text-xs font-semibold uppercase text-accent/70"><%= t(".off_slot_heading") %></div>
            <div class="space-y-2">
              <% usage.off_slot_surgeries.each do |surgery| %>
                <div class="rounded-box border border-accent/30 bg-accent/5 p-2.5 text-sm">
                  <%= render "slot_surgery", surgery: surgery %>
                </div>
              <% end %>
            </div>
          <% end %>

          <div class="divider my-1"><%= Surgery.scheduling_type_options["emergency"] %></div>
          <div class="space-y-2">
            <%# Rendered through the same partial as every other card on the
                board (and as the operations calendar's emergency cards), so an
                emergency case booked in the cath lab or a procedure room still
                carries its slot-category badge instead of silently looking
                like a main-OR case. %>
            <% if usage.emergency_surgeries.any? %>
              <% usage.emergency_surgeries.each do |surgery| %>
                <div class="rounded-box border border-error/40 p-3 text-sm">
                  <%= render "slot_surgery", surgery: surgery %>
                </div>
              <% end %>
            <% else %>
              <p class="text-base-content/40 italic text-sm"><%= t(".no_emergency_surgeries") %></p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
