<% content_for :title, "Surgery Schedule" %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker">Operations</p>
        <h1 class="app-page-title">Surgery Schedule</h1>
        <p class="text-base-content/60 mt-1">
          Week of <%= @week_start.strftime("%B %d, %Y") %>
        </p>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "Prev Week", surgery_schedule_path(week_of: @previous_week), class: "btn btn-sm" %>
        <%= link_to "This Week", surgery_schedule_path, class: "btn btn-sm btn-ghost" %>
        <%= link_to "Next Week", surgery_schedule_path(week_of: @next_week), class: "btn btn-sm" %>
        <%= link_to "Configure slots", elective_slot_rules_path, class: "btn btn-sm btn-outline" %>
        <%= link_to "Holidays", holidays_path, class: "btn btn-sm btn-outline" %>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-7 gap-4">
    <% @dates.each do |date| %>
      <% usage = @slot_usages[date] %>
      <div class="app-panel">
        <div class="app-panel-body space-y-4">
          <div>
            <p class="text-xs font-bold uppercase text-base-content/40"><%= date.strftime("%A") %></p>
            <p class="text-lg font-semibold"><%= date.strftime("%Y-%m-%d") %></p>
            <% if usage.holiday? %>
              <span class="badge badge-secondary badge-sm mt-1"><%= usage.holiday.name %></span>
            <% end %>
            <p class="text-sm text-base-content/60">
              <% if usage.configured? %>
                <%= usage.used_slots %> / <%= usage.slot_count %> slots in use
                <span class="text-base-content/40">(<%= usage.used_minutes %> / <%= usage.capacity_minutes %> min)</span>
              <% elsif usage.holiday? %>
                No elective slots (holiday)
              <% else %>
                No slots configured
              <% end %>
            </p>
          </div>

          <% usage.warnings.each do |warning| %>
            <div role="alert" class="alert alert-warning py-2 text-xs"><span><%= warning %></span></div>
          <% end %>

          <%# A slot is a whole day of one operating room, so it lists every
              surgery booked into it and is flagged only when their combined
              time runs past the slot's duration. %>
          <div class="space-y-2">
            <% usage.slots.each do |slot| %>
              <div class="rounded-box border p-3 text-sm space-y-2 <%= slot.empty? ? "border-base-200 border-dashed bg-base-200/40" : slot.overrun? ? "border-warning/60 bg-warning/5" : "border-base-200 bg-base-100" %>">
                <%# Stacked rather than side by side: the week board gives each
                    day a narrow column, and a horizontal row wraps badly. %>
                <div>
                  <p class="text-xs font-bold uppercase text-base-content/40">Slot <%= slot.number %></p>
                  <p class="font-mono text-xs text-base-content/50 whitespace-nowrap"><%= slot.used_minutes %> / <%= slot.duration_minutes %> min</p>
                </div>

                <% if slot.overrun? %>
                  <span class="badge badge-warning badge-sm whitespace-nowrap">+<%= slot.overrun_minutes %> min over</span>
                <% end %>

                <% if slot.empty? %>
                  <span class="text-base-content/40 italic">Open</span>
                <% else %>
                  <div class="space-y-2">
                    <% slot.surgeries.each do |surgery| %>
                      <div class="rounded border border-base-200 bg-base-100 p-2">
                        <%= render "slot_surgery", surgery: surgery %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <% if usage.unscheduled_surgeries.any? %>
            <div class="space-y-2">
              <p class="text-xs font-bold uppercase text-error"><%= usage.configured? ? "Not assigned to a slot" : "No slot available" %></p>
              <% usage.unscheduled_surgeries.each do |surgery| %>
                <div class="rounded-box border border-error/40 bg-error/5 p-3 text-sm">
                  <%= render "slot_surgery", surgery: surgery %>
                </div>
              <% end %>
            </div>
          <% end %>

          <div class="divider my-1">Emergency</div>
          <div class="space-y-2">
            <% if usage.emergency_surgeries.any? %>
              <% usage.emergency_surgeries.each do |surgery| %>
                <div class="rounded-box border border-error/40 p-3 text-sm">
                  <div class="flex justify-between items-baseline">
                    <span class="font-semibold"><%= surgery.patient&.name || "Patient ##{surgery.patient_id}" %></span>
                    <span class="font-mono text-xs"><%= surgery.start_time_display %></span>
                  </div>
                  <div class="text-base-content/70"><%= surgery.display_procedure_name %></div>
                </div>
              <% end %>
            <% else %>
              <p class="text-base-content/40 italic text-sm">None</p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
