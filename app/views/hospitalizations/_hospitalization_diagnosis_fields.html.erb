<div class="rounded-box border border-base-200 bg-base-100 p-4 space-y-3" data-hospitalization-diagnosis-fields-target="item">
  <%= diagnosis_fields.hidden_field :_destroy, data: { hospitalization_diagnosis_fields_target: "destroyField" } %>
  <% if diagnosis_fields.object.persisted? %>
    <%= diagnosis_fields.hidden_field :id %>
  <% end %>

  <%= render "shared/picker_field",
        form: diagnosis_fields,
        attribute: :diagnosis_id,
        label: HospitalizationDiagnosis.human_attribute_name(:diagnosis_id),
        selected_label: diagnosis_fields.object.diagnosis&.name,
        placeholder: t("diagnoses.picker.unselected"),
        picker_path: picker_diagnoses_path,
        picker_frame: "diagnosis_picker_frame",
        choose_label: t("diagnoses.picker.choose_button"),
        event_name: "diagnosis:picked" %>

  <div class="flex justify-end">
    <button type="button" class="btn btn-ghost btn-sm" data-action="hospitalization-diagnosis-fields#remove"><%= t(".remove_button") %></button>
  </div>
</div>
