<% content_for :title, t(".title") %>

<div class="app-page">
  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= t(".kicker") %></p>
        <h1 class="app-page-title"><%= @audit_event.record_label %></h1>
      </div>
      <%= link_to t("common.back"), audit_events_path, class: "btn btn-ghost" %>
    </div>
  </section>

  <div class="app-panel p-6">
    <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div><dt class="text-sm text-base-content/60"><%= t("audit_events.labels.time") %></dt><dd class="font-medium"><%= l(@audit_event.created_at, format: :timestamp) %></dd></div>
      <div><dt class="text-sm text-base-content/60"><%= t("audit_events.labels.record_type") %></dt><dd class="font-medium"><%= @audit_event.auditable_type %></dd></div>
      <div><dt class="text-sm text-base-content/60"><%= t(".record_id_label") %></dt><dd class="font-mono"><%= @audit_event.auditable_id %></dd></div>
      <div><dt class="text-sm text-base-content/60"><%= AuditEvent.human_attribute_name(:action) %></dt><dd><span class="badge badge-outline"><%= @audit_event.action %></span></dd></div>
      <div><dt class="text-sm text-base-content/60"><%= t("audit_events.labels.operator") %></dt><dd class="font-medium"><%= @audit_event.user&.name || t("common.none") %></dd></div>
      <div><dt class="text-sm text-base-content/60"><%= t(".ip_address_label") %></dt><dd class="font-mono"><%= @audit_event.ip_address || t("common.none") %></dd></div>
    </dl>
  </div>

  <div class="app-panel overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead><tr><th class="bg-base-200"><%= t("common.field_header") %></th><th class="bg-base-200"><%= t("common.before_header") %></th><th class="bg-base-200"><%= t("common.after_header") %></th></tr></thead>
        <tbody>
          <% change_rows = audit_change_rows(@audit_event) %>
          <% if change_rows.any? %>
            <% change_rows.each do |row| %>
              <tr>
                <td class="font-semibold"><%= row[:label] %></td>
                <td class="whitespace-pre-wrap"><%= row[:before] %></td>
                <td class="whitespace-pre-wrap"><%= row[:after] %></td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="3" class="text-center py-10 text-base-content/50 italic"><%= t(".no_changes") %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
