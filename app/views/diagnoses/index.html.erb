<% content_for :title, t(".title") %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= t("common.master_data") %></p>
        <h1 class="app-page-title"><%= t(".title") %></h1>
      </div>
      <%= link_to new_diagnosis_path, class: "btn btn-primary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        <%= t(".new_button") %>
      <% end %>
    </div>
  </section>

  <div class="app-panel overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th class="bg-base-200"><%= Diagnosis.human_attribute_name(:name) %></th>
            <th class="bg-base-200 text-right"><%= t("common.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% if @diagnoses.any? %>
            <% @diagnoses.each do |diagnosis| %>
              <tr class="row-hover">
                <td class="font-semibold"><%= diagnosis.name %></td>
                <td class="text-right flex justify-end gap-2">
                  <%= link_to t("common.view"), diagnosis, class: "btn btn-ghost btn-xs text-primary" %>
                  <%= link_to t("common.edit"), edit_diagnosis_path(diagnosis), class: "btn btn-ghost btn-xs text-secondary" %>
                  <%= button_to t("common.delete"), diagnosis, method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: t("common.confirm_delete") } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="2" class="text-center py-10 text-base-content/50 italic">
                <%= t(".empty") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
