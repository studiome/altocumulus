<% content_for :title, "Diagnoses" %>

<div class="app-page">
  <% if notice.present? %>
    <div class="toast toast-top toast-end z-50">
      <div class="alert alert-success">
        <span><%= notice %></span>
      </div>
    </div>
  <% end %>

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker">Master Data</p>
        <h1 class="app-page-title">Diagnoses</h1>
      </div>
      <%= link_to new_diagnosis_path, class: "btn btn-primary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        New Diagnosis
      <% end %>
    </div>
  </section>

  <div class="app-panel overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th class="bg-base-200">Name</th>
            <th class="bg-base-200 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @diagnoses.any? %>
            <% @diagnoses.each do |diagnosis| %>
              <tr class="hover">
                <td class="font-semibold"><%= diagnosis.name %></td>
                <td class="text-right flex justify-end gap-2">
                  <%= link_to "View", diagnosis, class: "btn btn-ghost btn-xs text-primary" %>
                  <%= link_to "Edit", edit_diagnosis_path(diagnosis), class: "btn btn-ghost btn-xs text-secondary" %>
                  <%= button_to "Delete", diagnosis, method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: "Are you sure?" } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="2" class="text-center py-10 text-base-content/50 italic">
                No diagnoses found. Click "New Diagnosis" to get started.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
