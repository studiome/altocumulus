<%= turbo_stream.replace "patient_diagnosis_diagnosis_id" do %>
  <%= select_tag "patient_diagnosis[diagnosis_id]",
    options_from_collection_for_select(@diagnoses, :id, :name, @diagnosis.id),
    id: "patient_diagnosis_diagnosis_id",
    prompt: t(".select_diagnosis_prompt"),
    class: "select w-full focus:select-primary" %>
<% end %>

<%= turbo_stream.remove "patient_diagnosis_no_diagnoses_warning" %>

<%= turbo_stream.replace "patient_diagnosis_submit" do %>
  <div class="pt-4" id="patient_diagnosis_submit">
    <%= tag.input type: "submit", value: t(".save_entry_submit"), class: "btn btn-primary w-full" %>
  </div>
<% end %>

<%= turbo_stream.replace "diagnosis_modal_frame" do %>
  <%= turbo_frame_tag "diagnosis_modal_frame", data: { action: "turbo:frame-load->diagnosis-modal#open" } do %>
    <div class="p-6 text-center"
         data-controller="diagnosis-modal-success"
         data-diagnosis-id="<%= @diagnosis.id %>"
         data-diagnosis-name="<%= @diagnosis.name %>">
      <div class="alert alert-success justify-start mb-4">
        <span><%= t(".success_notice") %></span>
      </div>
      <p class="text-sm text-base-content/60"><%= t(".added_helper_text") %></p>
    </div>
  <% end %>
<% end %>
