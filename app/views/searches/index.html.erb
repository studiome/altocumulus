<% content_for :title, t(".title") %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= t(".kicker") %></p>
        <h1 class="app-page-title"><%= t(".title") %></h1>
      </div>
      <%= form_with url: search_path, method: :get, local: true, class: "flex items-end gap-2 flex-wrap" do |f| %>
        <div class="app-filter-field">
          <label class="app-filter-label"><%= t(".keyword_label") %></label>
          <%= f.text_field :keyword, value: @keyword, placeholder: t(".keyword_placeholder"), class: "input input-sm w-72", autofocus: true %>
        </div>
        <%= f.submit t("common.search"), class: "btn btn-primary btn-sm" %>
        <% if @keyword.present? %>
          <%= link_to t("common.clear"), search_path, class: "btn btn-ghost btn-sm" %>
        <% end %>
      <% end %>
    </div>
  </section>

  <% if @keyword.blank? %>
    <div class="app-empty-state"><%= t(".empty_state") %></div>
  <% else %>
    <div class="space-y-6">
      <div class="app-panel overflow-hidden">
        <div class="app-panel-body">
          <div class="flex items-center justify-between mb-2">
            <h2 class="card-title"><%= t(".patients_heading") %></h2>
            <%= link_to t(".see_all_patients"), patients_path(keyword: @keyword), class: "app-inline-link text-sm" %>
          </div>
          <% if @patients.any? %>
            <ul class="space-y-1 text-sm">
              <% @patients.each do |patient| %>
                <li class="flex items-center justify-between gap-2 border-b border-base-200 py-1 last:border-0">
                  <%= link_to patient.name, patient, class: "app-inline-link" %>
                  <span class="text-base-content/50 font-mono"><%= patient.hospital_id %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-base-content/40 italic text-sm"><%= t(".no_matching_patients") %></p>
          <% end %>
        </div>
      </div>

      <div class="app-panel overflow-hidden">
        <div class="app-panel-body">
          <div class="flex items-center justify-between mb-2">
            <h2 class="card-title"><%= t(".hospitalizations_heading") %></h2>
            <%= link_to t(".see_all_hospitalizations"), hospitalizations_path(keyword: @keyword), class: "app-inline-link text-sm" %>
          </div>
          <% if @hospitalizations.any? %>
            <ul class="space-y-1 text-sm">
              <% @hospitalizations.each do |hospitalization| %>
                <li class="flex items-center justify-between gap-2 border-b border-base-200 py-1 last:border-0">
                  <%= link_to hospitalization.reason.presence || t(".no_reason"), hospitalization, class: "app-inline-link truncate" %>
                  <span class="text-base-content/50 whitespace-nowrap">
                    <%= hospitalization.patient&.name %>
                    &middot;
                    <%= hospitalization.effective_admission_date ? l(hospitalization.effective_admission_date, format: :default) : t(".undated") %>
                  </span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-base-content/40 italic text-sm"><%= t(".no_matching_hospitalizations") %></p>
          <% end %>
        </div>
      </div>

      <div class="app-panel overflow-hidden">
        <div class="app-panel-body">
          <div class="flex items-center justify-between mb-2">
            <h2 class="card-title"><%= t(".surgeries_heading") %></h2>
            <%= link_to t(".see_all_surgeries"), surgeries_path(keyword: @keyword), class: "app-inline-link text-sm" %>
          </div>
          <% if @surgeries.any? %>
            <ul class="space-y-1 text-sm">
              <% @surgeries.each do |surgery| %>
                <li class="flex items-center justify-between gap-2 border-b border-base-200 py-1 last:border-0">
                  <%= link_to surgery.patient&.name || t(".unknown_patient_name", id: surgery.patient_id), surgery, class: "app-inline-link truncate" %>
                  <span class="text-base-content/50 whitespace-nowrap"><%= surgery.surgery_date_display %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-base-content/40 italic text-sm"><%= t(".no_matching_surgeries") %></p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
