<% content_for :title, t(".title") %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= t(".kicker") %></p>
        <h1 class="app-page-title"><%= t(".title") %></h1>
      </div>
      <%= form_with url: search_path, method: :get, local: true, class: "flex items-end gap-2 flex-wrap" do |f| %>
        <%= hidden_field_tag :tab, @tab, id: nil if @tab %>
        <div class="app-filter-field">
          <label class="app-filter-label"><%= t(".keyword_label") %></label>
          <%= f.text_field :keyword, value: @keyword, placeholder: t(".keyword_placeholder"), class: "input input-sm w-72", autofocus: true %>
        </div>
        <%= f.submit t("common.search"), class: "btn btn-primary btn-sm" %>
        <% if @keyword.present? %>
          <%= link_to t("common.clear"), search_path, class: "btn btn-ghost btn-sm" %>
        <% end %>
      <% end %>
    </div>
  </section>

  <% if @keyword.blank? %>
    <div class="app-empty-state"><%= t(".empty_state") %></div>
  <% else %>
    <%# Tabs are plain links (a reload, so the keyword rides in the URL). %>
    <div role="tablist" aria-label="<%= t(".tabs_label") %>" class="tabs tabs-border">
      <% SearchesController::TABS.each do |tab| %>
        <% selected = tab == @tab %>
        <%= link_to t(".tab_label", label: t(".#{tab}_heading"), count: @counts[tab]), search_path(keyword: @keyword, tab: tab),
              id: "search-tab-#{tab}", role: "tab", class: "tab #{"tab-active" if selected}",
              aria: { selected: selected.to_s, controls: "search-panel" }, tabindex: (selected ? 0 : -1) %>
      <% end %>
    </div>

    <div id="search-panel" role="tabpanel" aria-labelledby="search-tab-<%= @tab %>" class="app-panel overflow-hidden">
      <div class="app-panel-body">
        <div class="flex items-center justify-between gap-2 mb-2 text-sm">
          <span class="text-base-content/60">
            <% if @counts[@tab] > @results.size %>
              <%= t(".showing_limited", shown: @results.size, count: @counts[@tab]) %>
            <% end %>
          </span>
          <%= link_to t(".see_all_#{@tab}"), { "hospitalizations" => hospitalizations_path(keyword: @keyword),
                                               "surgeries" => surgeries_path(keyword: @keyword),
                                               "patients" => patients_path(keyword: @keyword) }[@tab], class: "app-inline-link" %>
        </div>
        <div class="overflow-x-auto">
          <%= render "searches/#{@tab}", results: @results, holidays: @holidays %>
        </div>
      </div>
    </div>
  <% end %>
</div>
