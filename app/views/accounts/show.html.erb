<% content_for :title, "My Account" %>

<div class="max-w-xl mx-auto w-full">
  <div class="mb-8">
    <h1 class="font-bold text-4xl">My Account</h1>
  </div>

  <div class="card bg-base-100 shadow-xl border border-base-200">
    <div class="card-body">
      <%= form_with model: @user, url: account_path, method: :patch, class: "app-form" do |form| %>
        <% if @user.errors.any? %>
          <div role="alert" class="alert alert-error mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
              <h3 class="font-bold"><%= pluralize(@user.errors.count, "error") %> prohibited this account from being saved:</h3>
              <ul class="list-disc ml-6">
                <% @user.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="app-field">
          <%= form.label :name, class: "app-field-label" %>
          <%= form.text_field :name, class: "input w-full focus:input-primary" %>
        </div>

        <div class="app-field">
          <%= form.label :email, class: "app-field-label" %>
          <%= form.email_field :email, class: "input w-full focus:input-primary" %>
        </div>

        <div class="divider">Change Password</div>
        <p class="app-helper">Leave these blank to keep your current password.</p>

        <div class="app-field">
          <%= form.label :current_password, "Current Password", class: "app-field-label" %>
          <%= form.password_field :current_password, class: "input w-full focus:input-primary", autocomplete: "current-password" %>
        </div>

        <div class="app-field">
          <%= form.label :password, "New Password", class: "app-field-label" %>
          <%= form.password_field :password, class: "input w-full focus:input-primary", autocomplete: "new-password" %>
        </div>

        <div class="app-field">
          <%= form.label :password_confirmation, "Confirm New Password", class: "app-field-label" %>
          <%= form.password_field :password_confirmation, class: "input w-full focus:input-primary", autocomplete: "new-password" %>
        </div>

        <div class="pt-4">
          <%= form.submit "Save Changes", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
