<% content_for :title, t(".title", team: @team.name) %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= link_to Team.model_name.human(count: 2), teams_path, class: "link" %></p>
        <h1 class="app-page-title">
          <%= @team.name %>
          <span class="badge badge-sm <%= @team.badge_class %>"><%= @team.color_label %></span>
        </h1>
      </div>
      <div class="flex gap-2">
        <% if admin? %>
          <%= button_to t(".copy_previous_button"), copy_previous_team_team_terms_path(@team), class: "btn btn-outline",
                data: { turbo_confirm: t(".copy_previous_confirm") } %>
          <%= link_to new_team_team_term_path(@team), class: "btn btn-primary" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <%= t(".new_button") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <div class="app-panel overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th><%= TeamTerm.human_attribute_name(:starts_on) %></th>
            <th><%= TeamTerm.human_attribute_name(:ends_on) %></th>
            <th><%= t(".members_heading") %></th>
            <th><%= TeamTerm.human_attribute_name(:note) %></th>
            <th class="text-right"><%= t("common.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% if @terms.any? %>
            <% @terms.each do |term| %>
              <tr class="row-hover">
                <td class="font-mono"><%= term.starts_on %></td>
                <td class="font-mono"><%= term.ends_on %></td>
                <td><%= term.members_display.presence || "-" %></td>
                <td><%= term.note.presence || "-" %></td>
                <td class="text-right flex justify-end gap-2">
                  <% if admin? %>
                    <%= link_to t("common.edit"), edit_team_team_term_path(@team, term), class: "btn btn-ghost btn-xs text-secondary" %>
                    <%= button_to t("common.delete"), team_team_term_path(@team, term), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: t("common.confirm_delete") } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="text-center py-10 text-base-content/50 italic"><%= t(".empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
