<% content_for :title, t(".title") %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= t("admin.kicker") %></p>
        <h1 class="app-page-title"><%= t(".title") %></h1>
      </div>
    </div>
  </section>

  <div class="app-panel">
    <div class="app-panel-body">
      <%= form_with model: @admin_note, url: admin_admin_notes_path, class: "app-form" do |form| %>
        <% if @admin_note.errors.any? %>
          <div role="alert" class="alert alert-error mb-4">
            <ul class="list-disc ml-6">
              <% @admin_note.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="app-field">
          <%= form.label :body, t(".new_note_label"), class: "app-field-label" %>
          <%= form.text_area :body, class: "textarea w-full focus:textarea-primary", rows: 3 %>
        </div>

        <div class="pt-2">
          <%= form.submit t(".add_note_submit"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="app-panel overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th class="bg-base-200"><%= t(".note_header") %></th>
            <th class="bg-base-200"><%= t(".by_header") %></th>
            <th class="bg-base-200"><%= t(".added_header") %></th>
            <th class="bg-base-200 text-right"><%= t("common.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @admin_notes.each do |note| %>
            <tr class="row-hover">
              <td class="whitespace-pre-wrap"><%= note.body %></td>
              <td><%= note.user&.name || t("common.none") %></td>
              <td><%= l(note.created_at, format: :short_timestamp) %></td>
              <td class="text-right">
                <%= button_to t("common.delete"), admin_admin_note_path(note), method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: t(".delete_confirm") } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
