<%= form_with(model: announcement, url: announcement.new_record? ? admin_announcements_path : admin_announcement_path(announcement), class: "app-form") do |form| %>
  <% if announcement.errors.any? %>
    <div role="alert" class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <h3 class="font-bold"><%= pluralize(announcement.errors.count, "error") %> prohibited this announcement from being saved:</h3>
        <ul class="list-disc ml-6">
          <% announcement.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="app-field">
    <%= form.label :title, class: "app-field-label" %>
    <%= form.text_field :title, class: "input w-full focus:input-primary" %>
  </div>

  <div class="app-field">
    <%= form.label :body, class: "app-field-label" %>
    <%= form.text_area :body, class: "textarea w-full focus:textarea-primary", rows: 4 %>
  </div>

  <div class="app-field">
    <label class="app-field-label flex items-center gap-2">
      <%= form.check_box :published, class: "checkbox" %>
      Published
    </label>
    <p class="app-helper">Only published announcements are visible on the operations calendar.</p>
  </div>

  <div class="pt-4">
    <%= form.submit class: "btn btn-primary w-full" %>
  </div>
<% end %>
