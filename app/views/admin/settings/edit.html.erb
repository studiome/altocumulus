<% content_for :title, t(".title") %>

<div class="max-w-xl mx-auto w-full">
  <div class="mb-8">
    <h1 class="app-page-title"><%= t(".title") %></h1>
    <p class="app-helper mt-2"><%= t(".description") %></p>
  </div>

  <div class="app-panel">
    <div class="card-body">
      <%= form_with(model: @app_setting, url: admin_settings_path, method: :patch, class: "app-form") do |form| %>
        <% if @app_setting.errors.any? %>
          <div role="alert" class="alert alert-error mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
              <h3 class="font-bold"><%= t(".errors_heading", count: @app_setting.errors.count) %></h3>
              <ul class="list-disc ml-6">
                <% @app_setting.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="app-field">
          <%= form.label :title, AppSetting.human_attribute_name(:title), class: "app-field-label" %>
          <%= form.text_field :title, class: "input w-full focus:input-primary", maxlength: AppSetting::MAX_TITLE_LENGTH %>
          <p class="app-helper"><%= t(".title_helper", default_title: AppSetting.default_title) %></p>
        </div>

        <fieldset class="app-field">
          <legend class="app-field-label"><%= AppSetting.human_attribute_name(:theme) %></legend>
          <div class="grid gap-2 sm:grid-cols-2">
            <% AppTheme::KEYS.each do |key| %>
              <% swatch = AppTheme.swatch(key) %>
              <label class="flex items-center gap-3 cursor-pointer border border-base-300 rounded-box px-3 py-2">
                <%= form.radio_button :theme, key, class: "radio radio-primary radio-sm" %>
                <span aria-hidden="true" class="inline-flex shrink-0">
                  <span class="inline-block w-6 h-6 rounded-l-sm" style="background-color: <%= swatch[:bar] %>"></span>
                  <span class="inline-block w-6 h-6 rounded-r-sm" style="background-color: <%= swatch[:primary] %>"></span>
                </span>
                <span><%= t("app_themes.#{key}") %></span>
              </label>
            <% end %>
          </div>
          <p class="app-helper"><%= t(".theme_helper") %></p>
        </fieldset>

        <div class="pt-4">
          <%= form.submit t(".submit_button"), class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
