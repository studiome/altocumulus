<% content_for :title, t(".title") %>

<div class="max-w-xl mx-auto w-full">
  <div class="mb-8">
    <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
    <p class="app-helper mt-2"><%= t(".description") %></p>
  </div>

  <div class="card bg-base-100 shadow-xl border border-base-200">
    <div class="card-body">
      <%= form_with(model: @app_setting, url: admin_settings_path, method: :patch, class: "app-form") do |form| %>
        <% if @app_setting.errors.any? %>
          <div role="alert" class="alert alert-error mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
              <h3 class="font-bold"><%= t(".errors_heading", count: @app_setting.errors.count) %></h3>
              <ul class="list-disc ml-6">
                <% @app_setting.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="app-field">
          <%= form.label :title, AppSetting.human_attribute_name(:title), class: "app-field-label" %>
          <%= form.text_field :title, class: "input w-full focus:input-primary", maxlength: AppSetting::MAX_TITLE_LENGTH %>
          <p class="app-helper"><%= t(".title_helper", default_title: AppSetting.default_title) %></p>
        </div>

        <div class="pt-4">
          <%= form.submit t(".submit_button"), class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
