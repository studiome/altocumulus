<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Altocumulus" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Altocumulus">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-shell flex flex-col">
    <header class="app-navbar print:hidden">
      <div class="flex-1 flex items-center gap-1">
        <%# Mobile-only menu: everything flattened into one dropdown so the
            navbar itself never has to lay out every item in a single row
            (that's what overflowed the 375px viewport). Hidden at lg and up,
            where the grouped horizontal menu below takes over instead. %>
        <div class="dropdown lg:hidden">
          <button type="button" tabindex="0" class="btn btn-ghost btn-square" aria-label="Open menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>
          <ul tabindex="0" class="menu dropdown-content menu-sm z-20 mt-3 w-64 rounded-box bg-base-100 p-2 shadow">
            <li><%= link_to "Calendar", operations_calendar_path %></li>
            <li><%= link_to "Patients", patients_path %></li>
            <li><%= link_to "Surgeries", surgeries_path %></li>
            <li><%= link_to "Hospitalizations", hospitalizations_path %></li>
            <li class="menu-title">Reports</li>
            <li><%= link_to "Dashboard", dashboard_path %></li>
            <li><%= link_to "Schedule", surgery_schedule_path %></li>
            <li><%= link_to "Audit Log", audit_events_path %></li>
            <li class="menu-title">Masters</li>
            <li><%= link_to "Diagnoses", diagnoses_path %></li>
            <li><%= link_to "Procedures", surgery_procedures_path %></li>
            <li><%= link_to "Slot Rules", elective_slot_rules_path %></li>
            <li><%= link_to "Holidays", holidays_path %></li>
            <% if current_user %>
              <% if admin? %>
                <li class="menu-title">Admin</li>
                <li><%= link_to "Users", admin_users_path %></li>
                <li><%= link_to "Announcements", admin_announcements_path %></li>
                <li><%= link_to "Admin Notes", admin_admin_notes_path %></li>
              <% end %>
              <li class="menu-title"><%= current_user.name %></li>
              <li><%= link_to "Account", account_path %></li>
              <li><%= button_to "Sign Out", logout_path, method: :delete %></li>
            <% end %>
          </ul>
        </div>

        <%= link_to "Altocumulus", root_path, class: "btn btn-ghost text-xl font-bold text-primary" %>
      </div>

      <%# Desktop menu: the same links, grouped into a handful of dropdowns
          (Reports, Masters, and -- admins only -- Admin) so the row stays
          short as items are added. Hidden below lg, where the mobile menu
          above takes over instead. %>
      <div class="hidden flex-none lg:flex lg:items-center lg:gap-2">
        <ul class="menu menu-horizontal px-1">
          <li><%= link_to "Calendar", operations_calendar_path %></li>
          <li><%= link_to "Patients", patients_path %></li>
          <li><%= link_to "Surgeries", surgeries_path %></li>
          <li><%= link_to "Hospitalizations", hospitalizations_path %></li>
          <li class="dropdown dropdown-end">
            <button type="button" tabindex="0">Reports</button>
            <ul tabindex="0" class="dropdown-content menu z-10 w-52 rounded-box bg-base-100 p-2 shadow">
              <li><%= link_to "Dashboard", dashboard_path %></li>
              <li><%= link_to "Schedule", surgery_schedule_path %></li>
              <li><%= link_to "Audit Log", audit_events_path %></li>
            </ul>
          </li>
          <li class="dropdown dropdown-end">
            <button type="button" tabindex="0">Masters</button>
            <ul tabindex="0" class="dropdown-content menu z-10 w-52 rounded-box bg-base-100 p-2 shadow">
              <li><%= link_to "Diagnoses", diagnoses_path %></li>
              <li><%= link_to "Procedures", surgery_procedures_path %></li>
              <li><%= link_to "Slot Rules", elective_slot_rules_path %></li>
              <li><%= link_to "Holidays", holidays_path %></li>
            </ul>
          </li>
          <% if current_user && admin? %>
            <li class="dropdown dropdown-end">
              <button type="button" tabindex="0">Admin</button>
              <ul tabindex="0" class="dropdown-content menu z-10 w-52 rounded-box bg-base-100 p-2 shadow">
                <li><%= link_to "Users", admin_users_path %></li>
                <li><%= link_to "Announcements", admin_announcements_path %></li>
                <li><%= link_to "Admin Notes", admin_admin_notes_path %></li>
              </ul>
            </li>
          <% end %>
        </ul>
        <% if current_user %>
          <div class="flex items-center gap-2">
            <%= link_to "Account", account_path, class: "btn btn-ghost btn-sm" %>
            <span class="text-sm text-base-content/60"><%= current_user.name %></span>
            <%= button_to "Sign Out", logout_path, method: :delete, class: "btn btn-ghost btn-sm" %>
          </div>
        <% end %>
      </div>
    </header>

    <%= render "shared/flash" %>

    <main class="app-main">
      <%= yield %>
    </main>

    <footer class="footer footer-center p-4 bg-base-100 text-base-content border-t border-base-200 print:hidden">
    </footer>
  </body>
</html>
