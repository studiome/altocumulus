<%= form_with(model: holiday, class: "app-form") do |form| %>
  <% if holiday.errors.any? %>
    <div role="alert" class="alert alert-error mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <h3 class="font-bold"><%= pluralize(holiday.errors.count, "error") %> prohibited this holiday from being saved:</h3>
        <ul class="list-disc ml-6">
          <% holiday.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="app-field">
    <%= form.label :date, class: "app-field-label" %>
    <%= form.date_field :date, class: "input w-full focus:input-primary" %>
  </div>

  <div class="app-field">
    <%= form.label :name, "Holiday Name", class: "app-field-label" %>
    <%= form.text_field :name, class: "input w-full focus:input-primary", placeholder: "e.g. Vernal Equinox Day" %>
  </div>

  <div class="pt-4">
    <%= form.submit class: "btn btn-primary w-full" %>
  </div>
<% end %>
