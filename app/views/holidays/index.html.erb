<% content_for :title, t(".title") %>

<div class="app-page">

  <section class="app-page-header">
    <div class="app-page-header-body">
      <div>
        <p class="app-page-kicker"><%= t("common.master_data") %></p>
        <h1 class="app-page-title"><%= t(".title") %></h1>
      </div>
      <%= link_to new_holiday_path, class: "btn btn-primary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        <%= t(".new_button") %>
      <% end %>
    </div>
  </section>

  <%= form_with url: holidays_path, method: :get, local: true, class: "app-filter-bar" do |f| %>
    <div class="app-filter-field">
      <label class="app-filter-label"><%= t(".year_filter_label") %></label>
      <%= f.select :year, @available_years, { include_blank: t(".all_years_option"), selected: params[:year] }, { class: "select select-sm" } %>
    </div>
    <%= f.submit t("common.search"), class: "btn btn-primary btn-sm" %>
    <% if params[:year].present? %>
      <%= link_to t("common.clear"), holidays_path, class: "btn btn-ghost btn-sm" %>
    <% end %>
  <% end %>

  <div class="app-panel overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th class="bg-base-200"><%= Holiday.human_attribute_name(:date) %></th>
            <th class="bg-base-200"><%= t(".type_header") %></th>
            <th class="bg-base-200"><%= Holiday.human_attribute_name(:name) %></th>
            <th class="bg-base-200"><%= Holiday.human_attribute_name(:note) %></th>
            <th class="bg-base-200 text-right"><%= t("common.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% if @holidays.any? %>
            <% @holidays.each do |holiday| %>
              <tr class="row-hover">
                <td class="font-mono font-medium"><%= holiday.date && l(holiday.date, format: :default) %></td>
                <td>
                  <% if holiday.holiday? %>
                    <span class="badge badge-secondary badge-sm"><%= t("holidays.status_badge.closed") %></span>
                  <% else %>
                    <span class="badge badge-ghost badge-sm"><%= t("holidays.status_badge.note_only") %></span>
                  <% end %>
                </td>
                <td class="font-semibold"><%= holiday.name %></td>
                <td class="text-base-content/60 max-w-xs truncate"><%= holiday.note %></td>
                <td class="text-right flex justify-end gap-2">
                  <%= link_to t("common.view"), holiday, class: "btn btn-ghost btn-xs text-primary" %>
                  <%= link_to t("common.edit"), edit_holiday_path(holiday), class: "btn btn-ghost btn-xs text-secondary" %>
                  <%= button_to t("common.delete"), holiday, method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: t("common.confirm_delete") } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="text-center py-10 text-base-content/50 italic">
                <% if params[:year].present? %>
                  <%= t(".empty_filtered") %>
                <% else %>
                  <%= t(".empty_no_filter") %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= render "shared/pagination", pagination: @pagination %>
</div>
