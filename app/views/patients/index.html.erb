<% content_for :title, "Patients" %>

<div class="w-full">
  <% if notice.present? %>
    <div class="toast toast-top toast-end z-50">
      <div class="alert alert-success">
        <span><%= notice %></span>
      </div>
    </div>
  <% end %>

  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="font-bold text-4xl mb-2">Patients</h1>
    </div>
    <%= link_to new_patient_path, class: "btn btn-primary" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
      New Patient
    <% end %>
  </div>

  <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th class="bg-base-200">Hospital ID</th>
            <th class="bg-base-200">Name</th>
            <th class="bg-base-200">Date of Birth</th>
            <th class="bg-base-200 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @patients.any? %>
            <% @patients.each do |patient| %>
              <tr class="hover">
                <td class="font-mono font-medium"><%= patient.hospital_id %></td>
                <td class="font-semibold"><%= patient.name %></td>
                <td><%= patient.date_of_birth.strftime("%Y-%m-%d") if patient.date_of_birth %></td>
                <td class="text-right flex justify-end gap-2">
                  <%= link_to "Add Diagnosis", new_patient_patient_diagnosis_path(patient), class: "btn btn-ghost btn-xs text-accent" %>
                  <%= link_to "View", patient, class: "btn btn-ghost btn-xs text-primary" %>
                  <%= link_to "Edit", edit_patient_path(patient), class: "btn btn-ghost btn-xs text-secondary" %>
                  <%= button_to "Delete", patient, method: :delete, class: "btn btn-ghost btn-xs text-error", data: { turbo_confirm: "Are you sure?" } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center py-10 text-base-content/50 italic">
                No patients found. Click "New Patient" to get started.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
