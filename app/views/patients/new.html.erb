<% content_for :title, t(".title") %>

<% if picker_frame_request? %>
  <%= turbo_frame_tag "patient_picker_frame" do %>
    <div class="p-6">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold"><%= t(".title") %></h2>
          <p class="text-sm text-base-content/60"><%= t(".modal_description") %></p>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" data-action="patient-picker-modal#close"><%= t("common.close") %></button>
      </div>

      <div class="mb-4">
        <%= link_to t("patients.picker.back_to_search"), picker_patients_path, class: "app-inline-link text-sm", data: { turbo_frame: "patient_picker_frame" } %>
      </div>

      <%= render "form", patient: @patient %>
    </div>
  <% end %>
<% else %>
  <div class="max-w-xl mx-auto w-full">
    <div class="mb-3 flex items-center gap-3">
      <%= link_to patients_path, class: "btn btn-circle btn-ghost" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
      <% end %>
      <h1 class="app-page-title"><%= t(".title") %></h1>
    </div>

    <div class="app-panel">
      <div class="card-body">
        <%= render "form", patient: @patient %>
      </div>
    </div>
  </div>
<% end %>
