<div id="<%= dom_id patient %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Hospital:</strong>
    <%= patient.hospital_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= patient.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Date of birth:</strong>
    <%= patient.date_of_birth %>
  </div>
</div>
