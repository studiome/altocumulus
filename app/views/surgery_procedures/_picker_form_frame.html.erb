<%# locals: surgery_procedure %>
<%= turbo_frame_tag "surgery_procedure_picker_frame", data: { action: "turbo:frame-load->picker-modal#open" } do %>
  <div class="p-6">
    <div class="flex items-start justify-between gap-4 mb-6">
      <div>
        <h2 class="text-2xl font-bold"><%= t("surgery_procedures.new.title") %></h2>
        <p class="text-sm text-base-content/60"><%= t("surgery_procedures.new.modal_description") %></p>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" data-action="picker-modal#close"><%= t("common.close") %></button>
    </div>

    <div class="mb-4">
      <%= link_to t("surgery_procedures.picker.back_to_search"), picker_surgery_procedures_path, class: "app-inline-link text-sm", data: { turbo_frame: "surgery_procedure_picker_frame" } %>
    </div>

    <%= render "form", surgery_procedure: surgery_procedure %>
  </div>
<% end %>
