<% content_for :title, "Surgery Procedure Details" %>

<div class="max-w-2xl mx-auto w-full">
  <% if notice.present? %>
    <div class="toast toast-top toast-end z-50">
      <div class="alert alert-success">
        <span><%= notice %></span>
      </div>
    </div>
  <% end %>

  <div class="mb-8 flex items-center gap-4">
    <%= link_to surgery_procedures_path, class: "btn btn-circle btn-ghost" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    <% end %>
    <h1 class="font-bold text-4xl">Surgery Procedure Details</h1>
  </div>

  <div class="card bg-base-100 shadow-xl border border-base-200">
    <div class="card-body">
      <div class="flex justify-between items-start mb-6">
        <div>
          <h2 class="card-title text-3xl mb-1 text-primary"><%= @surgery_procedure.name %></h2>
          <p class="text-base-content/60 font-mono">Procedure Master</p>
        </div>
        <div class="badge badge-outline badge-lg p-4">Master Record</div>
      </div>

      <div class="divider">Information</div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
        <div>
          <span class="text-xs font-bold uppercase text-base-content/40 block mb-1">Name</span>
          <span class="text-lg font-medium"><%= @surgery_procedure.name %></span>
        </div>
      </div>

      <div class="card-actions justify-end mt-4 pt-6 border-t border-base-200">
        <%= link_to "Edit Procedure", edit_surgery_procedure_path(@surgery_procedure), class: "btn btn-secondary" %>
        <%= button_to "Delete Procedure", @surgery_procedure, method: :delete, class: "btn btn-outline btn-error", data: { turbo_confirm: "Are you sure?" } %>
      </div>
    </div>
  </div>
</div>