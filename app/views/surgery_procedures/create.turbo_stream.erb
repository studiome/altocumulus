<%= turbo_stream.replace "surgery_procedure_modal_frame" do %>
  <%= turbo_frame_tag "surgery_procedure_modal_frame", data: { action: "turbo:frame-load->surgery-procedure-modal#open" } do %>
    <div class="p-6 text-center"
         data-controller="surgery-procedure-modal-success"
         data-procedure-id="<%= @surgery_procedure.id %>"
         data-procedure-name="<%= @surgery_procedure.name %>">
      <div class="alert alert-success justify-start mb-4">
        <span>Surgery procedure was successfully created.</span>
      </div>
      <p class="text-sm text-base-content/60">The new procedure has been added to the surgery form.</p>
    </div>
  <% end %>
<% end %>
