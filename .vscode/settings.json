{
    "workbench.colorTheme": "Dark OG",
    "editor.fontFamily": "'SF Mono', Menlo, Monaco, 'Courier New', monospace",
    "terminal.integrated.fontFamily": "'SFMono Terminal'",
    "terminal.integrated.fontSize": 10,

    // Ruby LSP (Shopify.ruby-lsp) + ruby-lsp-rails.
    // Both gems live in the development group of the Gemfile, so the extension
    // runs them with `bundle exec ruby-lsp` — no custom bundle needed.

    // "auto" detects whatever supplies Ruby in the current environment:
    //   - GitHub Codespaces / local machines using mise -> mise
    //   - .devcontainer image (Ruby baked into /usr/local) -> none
    // Set an explicit identifier only if detection ever picks the wrong one.
    "rubyLsp.rubyVersionManager": {
        "identifier": "auto"
    },
    // RuboCop (rubocop-rails-omakase, see .rubocop.yml) runs in-process in the
    // language server instead of spawning a `rubocop` process per request.
    "rubyLsp.formatter": "rubocop_internal",
    "rubyLsp.linters": [
        "rubocop_internal"
    ],
    "[ruby]": {
        "editor.defaultFormatter": "Shopify.ruby-lsp",
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
    },
    "[erb]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    }
}
